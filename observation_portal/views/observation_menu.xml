<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Website top menu -> modern HSE self-service portal -->
        <record id="menu_observation_website" model="website.menu">
            <field name="name">HSE Portal</field>
            <field name="url">/hse/portal</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">150</field>
        </record>

        <!-- Direct Web Portal URL Launchers inside the HSE backend -->
        <record id="action_observation_portal_web_url" model="ir.actions.act_url">
            <field name="name">HSE Portal (Modern)</field>
            <field name="url">/hse/portal</field>
            <field name="target">new</field>
        </record>

        <record id="action_observation_portal_obs_url" model="ir.actions.act_url">
            <field name="name">Submit Safety Observation (Web)</field>
            <field name="url">/hse/portal/observation</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_observation_portal_in_hse"
                  name="HSE Self-Service Portal (Web)"
                  parent="hse.menu_hse_incidents"
                  sequence="10"
                  action="action_observation_portal_web_url"/>

    </data>
</odoo>
