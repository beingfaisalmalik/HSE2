<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="observation_form_template" name="Observation Portal Form">
            <t t-call="website.layout">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card shadow-sm border-0 rounded-3">
                                <div class="card-header bg-gradient text-white p-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                                    <div class="d-flex align-items-center gap-3">
                                        <div style="width: 48px; height: 48px; background: rgba(56, 189, 248, 0.2); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fa fa-eye fa-2x text-info"/>
                                        </div>
                                        <div>
                                            <h3 class="mb-1 text-white font-weight-bold">Safety Observation Portal</h3>
                                            <p class="mb-0 text-white-50 small">Report proactive hazard observations, unsafe conditions, or positive safety interventions</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-body p-4">
                                    <t t-if="request.params.get('success')">
                                        <div class="alert alert-success d-flex align-items-center gap-3 mb-4 rounded-3 p-3">
                                            <i class="fa fa-check-circle fa-2x text-success"/>
                                            <div>
                                                <strong>Observation Submitted Successfully!</strong>
                                                <p class="mb-0 small">Thank you for contributing to our proactive safety culture. Your observation has been logged for review.</p>
                                            </div>
                                        </div>
                                    </t>

                                    <form action="/observation/form/submit" method="post" enctype="multipart/form-data" class="portal-form">
                                        <!-- CSRF Token -->
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <div class="row g-3 mb-3">
                                            <div class="col-md-6">
                                                <label for="name" class="form-label font-weight-bold">Observer Full Name <span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-light"><i class="fa fa-user text-muted"/></span>
                                                    <input type="text" id="name" name="name" required="true" class="form-control" placeholder="e.g. John Doe"/>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="employee_code" class="form-label font-weight-bold">Employee / Badge ID <span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-light"><i class="fa fa-id-badge text-muted"/></span>
                                                    <input type="text" id="employee_code" name="employee_code" required="true" class="form-control" placeholder="e.g. EMP-1049"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row g-3 mb-3">
                                            <div class="col-md-6">
                                                <label for="hazard_type" class="form-label font-weight-bold">Hazard Category</label>
                                                <select id="hazard_type" name="hazard_type" class="form-select">
                                                    <option value="physical" selected="selected">Physical Hazard (Trips, Falling objects, Heat)</option>
                                                    <option value="chemical">Chemical / Vapor Hazard</option>
                                                    <option value="biological">Biological Hazard</option>
                                                    <option value="other">Other Operational Condition</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="priority" class="form-label font-weight-bold">Urgency / Priority</label>
                                                <select id="priority" name="priority" class="form-select">
                                                    <option value="1">Low - Routine</option>
                                                    <option value="2" selected="selected">Normal - Standard Attention</option>
                                                    <option value="3">High - Immediate Action Needed</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="row g-3 mb-3">
                                            <div class="col-md-6">
                                                <label for="location_id" class="form-label font-weight-bold">Plant Location / Area</label>
                                                <select id="location_id" name="location_id" class="form-select">
                                                    <option value="">-- Select Plant Location (Optional) --</option>
                                                    <t t-if="locations">
                                                        <t t-foreach="locations" t-as="loc">
                                                            <option t-att-value="loc.id"><t t-esc="loc.name"/> (<t t-esc="loc.code"/>)</option>
                                                        </t>
                                                    </t>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="hazard_photo" class="form-label font-weight-bold">Hazard Site Photo (Evidence)</label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-light"><i class="fa fa-camera text-muted"/></span>
                                                    <input type="file" id="hazard_photo" name="hazard_photo" accept="image/*" class="form-control"/>
                                                </div>
                                                <div class="form-text small text-muted">Upload a photo taken on your smartphone or camera</div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="observation" class="form-label font-weight-bold">Safety Observation Details <span class="text-danger">*</span></label>
                                            <textarea id="observation" name="observation" required="true" rows="4" class="form-control" placeholder="Describe exactly what you observed (machinery, behavior, potential consequence)..."></textarea>
                                        </div>

                                        <div class="mb-4">
                                            <label for="immediate_action" class="form-label font-weight-bold">Immediate Action Taken (If any)</label>
                                            <textarea id="immediate_action" name="immediate_action" rows="2" class="form-control" placeholder="Describe any immediate interim action you took to eliminate or barricade the hazard..."></textarea>
                                        </div>

                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="reset" class="btn btn-outline-secondary px-4">Clear Form</button>
                                            <button type="submit" class="btn btn-primary px-5 font-weight-bold">
                                                <i class="fa fa-paper-plane me-1"/> Submit Observation
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
