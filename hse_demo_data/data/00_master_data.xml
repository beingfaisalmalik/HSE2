        <!-- ================= Knowledge base (solutions) ================== -->
        <record id="dd_sol_1" model="hse.solution">
            <field name="name">Eliminating K-301 Summer Trips (Suction Temperature Control)</field>
            <field name="solution_code">SOL-001</field>
            <field name="category">mechanical</field>
            <field name="applicable_equipment">compressors</field>
            <field name="problem_symptoms">Recurrent high-temperature trips on the main air compressor during ambient peaks, causing unit upsets approximately twice per month.</field>
            <field name="root_cause_addressed">Undersized suction air cooler combined with fouled inter-stage piping raising discharge temperature beyond the trip threshold.</field>
            <field name="detailed_solution">&lt;p&gt;Install a trimmed intercooler and adopt a predictive cleaning routine based on vibration &amp; temperature trending; update the alarm rationalization document.&lt;/p&gt;</field>
        </record>
        <record id="dd_sol_2" model="hse.solution">
            <field name="name">Chemical Drum Handling — Drum Trolley Intervention</field>
            <field name="solution_code">SOL-002</field>
            <field name="category">human_factors</field>
            <field name="applicable_equipment">general</field>
            <field name="problem_symptoms">Manual drum handling in the warehouse caused two near-miss hand injuries and consistent ergonomic complaints.</field>
            <field name="root_cause_addressed">No mechanical handling aid available at the decanting station.</field>
            <field name="detailed_solution">&lt;p&gt;Procure ATEX-rated drum trolleys, redefine the decanting station layout and add the task to the BBS observation checklist.&lt;/p&gt;</field>
        </record>

