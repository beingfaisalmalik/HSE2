        <!-- ================= Policies & SOPs (external portal) ========== -->
        <record id="dd_pol_001" model="hse.operating.policy">
            <field name="name">Life-Saving Rules &amp; Core HSE Policy</field>
            <field name="policy_code">POL-HSE-001</field>
            <field name="policy_type">life_saving</field>
            <field name="state">approved</field>
            <field name="effective_date" eval="(datetime.now() - timedelta(days=60)).strftime('%Y-%m-%d')"/>
            <field name="policy_statement">&lt;p&gt;Every person on site has the authority and obligation to stop unsafe work. The Life-Saving Rules apply to employees and contractors without exception.&lt;/p&gt;</field>
            <field name="core_principles">1. Work with a valid permit. 2. Verify isolation before work. 3. Never enter a confined space without clearance. 4. Protect yourself against falls. 5. Stop work when conditions change.</field>
            <field name="mandatory_rules">Violations trigger immediate stop-work, formal investigation and coaching. Repeated violations follow the disciplinary matrix.</field>
        </record>
        <record id="dd_pol_002" model="hse.operating.policy">
            <field name="name">Management of Change (MOC) Governance</field>
            <field name="policy_code">POL-HSE-002</field>
            <field name="policy_type">asset_integrity</field>
            <field name="state">approved</field>
            <field name="effective_date" eval="(datetime.now() - timedelta(days=120)).strftime('%Y-%m-%d')"/>
            <field name="policy_statement">&lt;p&gt;All permanent, temporary and organizational changes require risk assessment and PSSR before start-up.&lt;/p&gt;</field>
            <field name="core_principles">1. No change without documented risk review. 2. PSSR before commissioning. 3. As-built documentation closure.</field>
            <field name="mandatory_rules">Emergency changes require retrospective MOC within 24 hours.</field>
        </record>

