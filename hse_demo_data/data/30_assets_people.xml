        </record>
        <record id="dd_tml_2" model="hse.training.matrix.line">
            <field name="matrix_id" ref="dd_tm_2026"/>
            <field name="employee_id" ref="dd_emp_sara"/>
            <field name="job_id" ref="dd_job_operator"/>
            <field name="competency_id" ref="dd_comp_ptw"/>
