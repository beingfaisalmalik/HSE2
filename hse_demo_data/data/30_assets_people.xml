        <!-- ================= Safety meetings ============================ -->
        <record id="dd_meet_1" model="hse.meeting">
            <field name="department_id" ref="dd_meetdept_operations"/>
            <field name="meeting_type_ids" ref="dd_mtype_toolbox"/>
            <field name="topic">Dropped Object Prevention &amp; Tool Tethering</field>
            <field name="present_employees">45</field>
            <field name="meeting_attend_employees">41</field>
            <field name="duration">0.5</field>
            <field name="meeting_datetime" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d 06:15:00')"/>
            <field name="minutes_of_meeting">&lt;p&gt;Crew briefed on Unit-200 scaffold clamp dropped object. Actions: tether audit at each PTW round; DROPS toolbox repeated for night shift.&lt;/p&gt;</field>
        </record>
        <record id="dd_meet_2" model="hse.meeting">
            <field name="department_id" ref="dd_meetdept_operations"/>
            <field name="meeting_type_ids" ref="dd_mtype_mgmt"/>
            <field name="topic">Monthly HSE Performance Review — KPIs, LTI Investigation &amp; Compliance</field>
            <field name="present_employees">14</field>
            <field name="meeting_attend_employees">12</field>
            <field name="duration">1.5</field>
            <field name="meeting_datetime" eval="(datetime.now() - timedelta(days=20)).strftime('%Y-%m-%d 14:00:00')"/>
            <field name="minutes_of_meeting">&lt;p&gt;Reviewed TRIR trend, days-without-LTI counter, ISO audit findings and MOC governance. CAPA overdue list assigned owners with dates.&lt;/p&gt;</field>
        </record>

        <!-- ================= Operator shift log ========================= -->
        <record id="dd_oplog_1" model="hse.operator.log">
            <field name="location_id" ref="dd_loc_unit100"/>
            <field name="shift_type">day</field>
            <field name="operating_status">normal</field>
            <field name="production_output">Ethylene 1,240 t; flare &lt;1% loss</field>
            <field name="field_operators">Ahmed Raza, Sara Khan</field>
            <field name="state">open</field>
        </record>

        <!-- ================= Equipment failure (ISO 14224) ============== -->
        <record id="dd_fail_k301" model="hse.failure.report">
            <field name="asset_id" ref="dd_asset_compressor"/>
            <field name="location_id" ref="dd_loc_unit100"/>
            <field name="failure_date" eval="(datetime.now() - timedelta(days=7)).strftime('%Y-%m-%d 03:40:00')"/>
            <field name="equipment_class">compressor</field>
            <field name="failure_mechanism">fatigue</field>
            <field name="failure_cause">lubrication</field>
            <field name="detection_method">alarm</field>
            <field name="impact_level">shutdown</field>
            <field name="failed_component">Drive-end bearing</field>
            <field name="failure_mode">vib_high</field>
            <field name="state">rcfa</field>
        </record>

        <!-- ================= Defect elimination ========================= -->
        <record id="dd_defect_k301" model="hse.defect.elimination">
            <field name="title">K-301 recurring summer high-temperature trips</field>
            <field name="asset_id" ref="dd_asset_compressor"/>
            <field name="location_id" ref="dd_loc_unit100"/>
            <field name="failures_last_12_months">24</field>
            <field name="defect_category">repeat_trip</field>
            <field name="defect_description">Two trips per month during ambient peaks; each trip flares &gt;2t and stresses the steam system.</field>
            <field name="underlying_cause">Undersized suction air cooler plus fouled inter-stage piping elevating discharge temperature.</field>
            <field name="elimination_strategy">Trim intercoolder capacity, adopt condition-based cleaning from vibration/temperature trending, update alarm rationalization.</field>
            <field name="state">action_execution</field>
        </record>

        <!-- ================= Continuous improvement ===================== -->
        <record id="dd_impr_drums" model="hse.improvement">
            <field name="title">Mechanical drum handling at warehouse decant station</field>
            <field name="initiative_type">suggestion</field>
            <field name="category">safety</field>
            <field name="current_state">Manual handling of 200L drums; two near-miss hand injuries and recurring ergonomic complaints.</field>
            <field name="proposed_solution">Introduce ATEX drum trolleys, re-layout decant station and add task to BBS checklist.</field>
            <field name="state">approved</field>
        </record>

    </data>
</odoo>
