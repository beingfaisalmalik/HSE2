            <field name="certifying_authority">DNV Inspection Services</field>
            <field name="inspector_name">Certified API 510 Inspector #510-8842</field>
            <field name="issue_date" eval="(datetime.now() - timedelta(days=395)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="inspection_interval_months">12</field>
            <field name="design_pressure_psi">690</field>
            <field name="test_pressure_psi">1035</field>
            <field name="inspection_findings">Wall thickness readings within t-min except nozzle N-3 (recommend UT follow-up in next window).</field>
        </record>
        <record id="dd_cert_psv" model="hse.equipment.certification">
