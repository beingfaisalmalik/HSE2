         competency records, training-gap matrix, meetings, operator log,
         failure reporting, defect elimination, continuous improvement. -->
    <data noupdate="1">

        <!-- ================= Equipment statutory certifications ========= -->
        <record id="dd_cert_pv" model="hse.equipment.certification">
