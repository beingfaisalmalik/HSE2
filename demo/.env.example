# Copy to .env at the repository root, or run python3 demo/generate_env.py
# (on Windows: python demo\generate_env.py). Compose reads the .env next to
# compose.demo.yml automatically; no shell sourcing is needed for `up`.
# Isolated demo databases only. Replace every empty secret with a distinct value.
DEMO_DATABASE=hse_client_demo
# The port published on your own machine. Change DEMO_HTTP_PORT and DEMO_BASE_URL
# together if 8069 is already taken, for example 8070 and http://localhost:8070.
DEMO_HTTP_PORT=8069
# Loopback only, so a laptop demo is not reachable from the local network.
# Set 0.0.0.0 deliberately when another machine must open the URL.
DEMO_HTTP_BIND=127.0.0.1
# Origin Odoo stores for itself. Keep it reachable from the presenting browser;
# localhost works for a laptop demo. Set your public HTTPS origin when hosting.
DEMO_BASE_URL=http://localhost:8069
POSTGRES_PASSWORD=
# Administrator password. At least 14 characters, no line breaks, distinct below.
DEMO_ADMIN_PASSWORD=
DEMO_PRESENTER_PASSWORD=
DEMO_PORTAL_PASSWORD=
# Optional. 1 rewrites account passwords and fictional branding from this file on
# the next demo-init run; restarting the stack never does that by itself.
DEMO_REPROVISION=
# Optional and not needed on localhost. Only for an HTTPS embedded preview host;
# normal deployments keep standard Odoo framing and same-tab sign-in.
DEMO_PREVIEW_EMBEDDED=
