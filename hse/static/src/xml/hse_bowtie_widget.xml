<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hse.BowtieWidget">
        <div class="hse-bowtie-diagram-container p-4 rounded-3 shadow-sm border bg-light my-3">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div style="width: 36px; height: 36px; background: #fae8ff; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="fa fa-sitemap fa-lg text-purple" style="color: #9333ea;"/>
                    </div>
                    <div>
                        <h5 class="mb-0 font-weight-bold text-dark">Process Safety Bow-Tie Barrier Model</h5>
                        <span class="text-muted small">Visual Barrier Health Evaluation (Threats → Preventive Barriers → Top Event → Mitigative Barriers → Consequences)</span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-success px-2 py-1"><i class="fa fa-check me-1"/> Effective</span>
                    <span class="badge bg-warning text-dark px-2 py-1"><i class="fa fa-exclamation me-1"/> Degraded</span>
                    <span class="badge bg-danger px-2 py-1"><i class="fa fa-times me-1"/> Failed / Defeated</span>
                </div>
            </div>

            <!-- Bowtie Diagram Layout -->
            <div class="row align-items-center g-3">
                <!-- Left Wing: Preventive Barriers -->
                <div class="col-md-5">
                    <div class="bowtie-wing p-3 rounded-3 bg-white border shadow-xs">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase font-weight-bold text-primary small">
                                <i class="fa fa-shield me-1"/> Preventive Safeguards
                            </span>
                            <span class="badge bg-primary rounded-pill"><t t-esc="preventiveBarriers.length"/> Barriers</span>
                        </div>
                        <t t-if="preventiveBarriers.length > 0">
                            <div class="d-flex flex-column gap-2">
                                <t t-foreach="preventiveBarriers" t-as="b" t-key="b.id">
                                    <div class="bowtie-card p-2 rounded border" t-attf-style="border-left: 4px solid #{b.status == 'effective' ? '#10b981' : (b.status == 'degraded' ? '#f59e0b' : '#ef4444')} !important;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <strong class="text-dark small"><t t-esc="b.name"/></strong>
                                            <span class="badge rounded-pill" t-att-class="getBarrierBadge(b.status).class">
                                                <t t-esc="getBarrierBadge(b.status).text"/>
                                            </span>
                                        </div>
                                        <div class="text-muted small mt-1">
                                            Threat: <em><t t-esc="b.threat"/></em>
                                        </div>
                                        <t t-if="b.failure">
                                            <div class="text-danger small mt-1 font-weight-bold">
                                                <i class="fa fa-warning me-1"/> <t t-esc="b.failure"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="text-center py-3 text-muted small">No preventive barriers registered.</div>
                        </t>
                    </div>
                </div>

                <!-- Center: Top Event Knot -->
                <div class="col-md-2 text-center">
                    <div class="bowtie-knot p-3 rounded-circle shadow border mx-auto d-flex flex-column align-items-center justify-content-center"
                         style="width: 130px; height: 130px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: white;">
                        <i class="fa fa-bullseye fa-2x text-warning mb-1"/>
                        <span class="font-weight-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Top Event</span>
                        <span class="small text-truncate px-1" style="font-size: 0.68rem; color: #cbd5e1;" t-att-title="topEventTitle">
                            <t t-esc="topEventTitle"/>
                        </span>
                    </div>
                </div>

                <!-- Right Wing: Mitigative Barriers -->
                <div class="col-md-5">
                    <div class="bowtie-wing p-3 rounded-3 bg-white border shadow-xs">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase font-weight-bold text-info small">
                                <i class="fa fa-life-ring me-1"/> Mitigative Safeguards
                            </span>
                            <span class="badge bg-info text-white rounded-pill"><t t-esc="mitigativeBarriers.length"/> Barriers</span>
                        </div>
                        <t t-if="mitigativeBarriers.length > 0">
                            <div class="d-flex flex-column gap-2">
                                <t t-foreach="mitigativeBarriers" t-as="b" t-key="b.id">
                                    <div class="bowtie-card p-2 rounded border" t-attf-style="border-left: 4px solid #{b.status == 'effective' ? '#10b981' : (b.status == 'degraded' ? '#f59e0b' : '#ef4444')} !important;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <strong class="text-dark small"><t t-esc="b.name"/></strong>
                                            <span class="badge rounded-pill" t-att-class="getBarrierBadge(b.status).class">
                                                <t t-esc="getBarrierBadge(b.status).text"/>
                                            </span>
                                        </div>
                                        <div class="text-muted small mt-1">
                                            Mitigates: <em><t t-esc="b.consequence"/></em>
                                        </div>
                                        <t t-if="b.failure">
                                            <div class="text-danger small mt-1 font-weight-bold">
                                                <i class="fa fa-warning me-1"/> <t t-esc="b.failure"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="text-center py-3 text-muted small">No mitigative barriers registered.</div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
