<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hse.GasGaugeWidget">
        <div class="hse-gas-gauge-panel p-3 rounded-3 shadow-sm border bg-white mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div style="width: 36px; height: 36px; background: #e0f2fe; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="fa fa-dashboard fa-lg text-primary"/>
                    </div>
                    <div>
                        <h6 class="mb-0 font-weight-bold text-dark">Multi-Gas Atmospheric Telemetry</h6>
                        <span class="text-muted small">Continuous / Periodic Gas Detection Monitor</span>
                    </div>
                </div>
                <div>
                    <t t-if="gasTests">
                        <t t-if="gasTests.isSafe">
                            <span class="badge bg-success px-3 py-2 rounded-pill font-weight-bold">
                                <i class="fa fa-check-circle me-1"/> Safe for Entry / Hot Work
                            </span>
                        </t>
                        <t t-else="">
                            <span class="badge bg-danger px-3 py-2 rounded-pill font-weight-bold animate-pulse">
                                <i class="fa fa-exclamation-triangle me-1"/> ATMOSPHERE UNSAFE - STOP WORK
                            </span>
                        </t>
                    </t>
                    <t t-else="">
                        <span class="badge bg-secondary px-3 py-2 rounded-pill">No Gas Test Sample Logged</span>
                    </t>
                </div>
            </div>

            <div class="row g-3">
                <!-- Oxygen O2 -->
                <div class="col-md-3 col-sm-6">
                    <div class="gas-card p-3 rounded-3 border" t-attf-style="border-left: 5px solid #{o2Status.color} !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="font-weight-bold text-dark">Oxygen (O₂)</span>
                            <span class="badge rounded-pill" t-attf-style="background:#{o2Status.color}; color:white;">
                                <t t-esc="o2Status.val"/>%
                            </span>
                        </div>
                        <div class="progress my-2" style="height: 10px; background: #e2e8f0;">
                            <div class="progress-bar progress-bar-striped" t-attf-style="width: #{o2Status.pct}%; background-color: #{o2Status.color};"/>
                        </div>
                        <div class="text-muted small font-italic"><t t-esc="o2Status.label"/></div>
                    </div>
                </div>

                <!-- LEL Flammable -->
                <div class="col-md-3 col-sm-6">
                    <div class="gas-card p-3 rounded-3 border" t-attf-style="border-left: 5px solid #{lelStatus.color} !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="font-weight-bold text-dark">Flammables (% LEL)</span>
                            <span class="badge rounded-pill" t-attf-style="background:#{lelStatus.color}; color:white;">
                                <t t-esc="lelStatus.val"/>%
                            </span>
                        </div>
                        <div class="progress my-2" style="height: 10px; background: #e2e8f0;">
                            <div class="progress-bar progress-bar-striped" t-attf-style="width: #{lelStatus.pct}%; background-color: #{lelStatus.color};"/>
                        </div>
                        <div class="text-muted small font-italic"><t t-esc="lelStatus.label"/></div>
                    </div>
                </div>

                <!-- H2S Toxic -->
                <div class="col-md-3 col-sm-6">
                    <div class="gas-card p-3 rounded-3 border" t-attf-style="border-left: 5px solid #{h2sStatus.color} !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="font-weight-bold text-dark">Hydrogen Sulfide (H₂S)</span>
                            <span class="badge rounded-pill" t-attf-style="background:#{h2sStatus.color}; color:white;">
                                <t t-esc="h2sStatus.val"/> ppm
                            </span>
                        </div>
                        <div class="progress my-2" style="height: 10px; background: #e2e8f0;">
                            <div class="progress-bar progress-bar-striped" t-attf-style="width: #{h2sStatus.pct}%; background-color: #{h2sStatus.color};"/>
                        </div>
                        <div class="text-muted small font-italic"><t t-esc="h2sStatus.label"/></div>
                    </div>
                </div>

                <!-- CO Carbon Monoxide -->
                <div class="col-md-3 col-sm-6">
                    <div class="gas-card p-3 rounded-3 border" t-attf-style="border-left: 5px solid #{coStatus.color} !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="font-weight-bold text-dark">Carbon Monoxide (CO)</span>
                            <span class="badge rounded-pill" t-attf-style="background:#{coStatus.color}; color:white;">
                                <t t-esc="coStatus.val"/> ppm
                            </span>
                        </div>
                        <div class="progress my-2" style="height: 10px; background: #e2e8f0;">
                            <div class="progress-bar progress-bar-striped" t-attf-style="width: #{coStatus.pct}%; background-color: #{coStatus.color};"/>
                        </div>
                        <div class="text-muted small font-italic"><t t-esc="coStatus.label"/></div>
                    </div>
                </div>
            </div>

            <t t-if="gasTests">
                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top text-muted small">
                    <div>
                        <i class="fa fa-user-circle me-1"/> Tested by: <strong><t t-esc="gasTests.tester"/></strong>
                    </div>
                    <div>
                        <i class="fa fa-clock-o me-1"/> Sample Timestamp: <strong><t t-esc="gasTests.time"/></strong>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
