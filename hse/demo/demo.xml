        <!-- Demo Proven Solution -->
        <record id="demo_solution_plan53" model="hse.solution">
            <field name="name">Installation of Pressurized Dual Barrier Seal System (API Plan 53B)</field>
            <field name="category">mechanical</field>
            <field name="applicable_equipment">pumps</field>
            <field name="problem_symptoms">Frequent seal face blistering and premature failure on light hydrocarbon charge pumps operating near bubble point.</field>
            <field name="root_cause_addressed">Vaporization of process fluid between seal faces causing dry running and thermal fracture.</field>
            <field name="detailed_solution">&lt;p&gt;Convert seal arrangement from single unpressurized seal to API 682 Dual Pressurized Cartridge Seal with Plan 53B bladder accumulator reservoir filled with synthetic ISO VG 32 barrier fluid maintained at 25 PSI above maximum seal chamber pressure.&lt;/p&gt;</field>
            <field name="engineering_standards">API Standard 682 4th Edition</field>
            <field name="estimated_implementation_cost">28000.0</field>
            <field name="estimated_annual_cost_avoidance">75000.0</field>
            <field name="rating">3</field>
            <field name="times_applied">6</field>
            <field name="state">published</field>
        </record>

        <!-- Demo Defect Elimination -->
        <record id="demo_defect_vibration" model="hse.defect.elimination">
            <field name="title">Elimination of Chronic Seal Flush Line Vibration &amp; Fatigue Cracking</field>
            <field name="asset_id" ref="demo_asset_pump"/>
            <field name="location_id" ref="hse.loc_cdu1"/>
            <field name="defect_category">vibration_resonance</field>
            <field name="failures_last_12_months">5</field>
            <field name="annual_maintenance_spend">18500.0</field>
            <field name="annual_production_loss">45000.0</field>
            <field name="defect_description">Small-bore 3/4-inch tubing on seal flush piping vibrates excessively at 120 Hz, causing fatigue cracking at socket weld nipples every 2-3 months.</field>
            <field name="underlying_cause">Overhung cantilevered orifice assembly vibrating in resonance with 2x running speed of the motor.</field>
            <field name="elimination_strategy">Install heavy-wall Sch 160 welded bracing gussets and stiffening clamp to rigid pump casing, shifting natural frequency above 250 Hz.</field>
            <field name="state">eliminated</field>
            <field name="track_30_days">True</field>
            <field name="track_60_days">True</field>
            <field name="track_90_days">True</field>
        </record>

