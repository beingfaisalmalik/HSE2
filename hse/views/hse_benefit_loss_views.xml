<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Benefit & Loss Form -->
    <record id="view_hse_benefit_loss_form" model="ir.ui.view">
        <field name="name">hse.benefit.loss.form</field>
        <field name="model">hse.benefit.loss</field>
        <field name="arch" type="xml">
            <form string="Benefits &amp; Losses Entry">
                <header>
                    <button name="action_verify" string="Finance / Operations Verify" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_close" string="Close Financial Entry" type="object" invisible="state != 'verified'" class="btn-success"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verified,closed"/>
                </header>
                <sheet>
                    <div class="hse-x-hero" style="background: linear-gradient(135deg, #064e3b 0%, #059669 100%); border-left: 6px solid #6ee7b7; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">💰</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Benefits &amp; Losses Ledger</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Financial impact of HSE events &amp; realized benefits</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="state" widget="badge" readonly="1"/></span></div></div>
                    <div class="oe_title">
                        <span class="text-muted"><field name="name"/></span>
                        <h1><field name="title" placeholder="Event / Impact Title"/></h1>
                    </div>
                    <group>
                        <group string="Classification &amp; Source">
                            <field name="event_type"/>
                            <field name="event_date"/>
                            <field name="location_id"/>
                            <field name="asset_id"/>
                        </group>
                        <group string="Originating Records">
                            <field name="incident_id"/>
                            <field name="investigation_id"/>
                            <field name="improvement_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Loss Breakdown" invisible="event_type != 'loss'">
                            <group>
                                <group string="Production Downtime">
                                    <field name="downtime_hours"/>
                                    <field name="production_volume_lost"/>
                                    <field name="production_unit"/>
                                    <field name="loss_production_cost" widget="monetary"/>
                                </group>
                                <group string="Asset Repair &amp; Maintenance">
                                    <field name="loss_equipment_repair" widget="monetary"/>
                                    <field name="loss_contractor_services" widget="monetary"/>
                                </group>
                            </group>
                            <group>
                                <group string="Environmental &amp; Regulatory">
                                    <field name="loss_environmental_cleanup" widget="monetary"/>
                                    <field name="loss_regulatory_fines" widget="monetary"/>
                                </group>
                                <group string="Safety &amp; Legal Costs">
                                    <field name="loss_medical_compensation" widget="monetary"/>
                                    <field name="loss_legal_fees" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                        <page string="Realized Benefits &amp; Cost Avoidance" invisible="event_type != 'benefit'">
                            <group>
                                <group>
                                    <field name="benefit_cost_avoidance" widget="monetary"/>
                                    <field name="benefit_energy_savings" widget="monetary"/>
                                    <field name="benefit_safety_roi" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                        <page string="Financial Summary &amp; Accounting Notes">
                            <group>
                                <group>
                                    <field name="total_loss" widget="monetary"/>
                                    <field name="total_benefit" widget="monetary"/>
                                    <field name="net_impact" widget="monetary"/>
                                </group>
                            </group>
                            <field name="notes" placeholder="Justification and accounting code references..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Benefit & Loss Tree -->
    <record id="view_hse_benefit_loss_tree" model="ir.ui.view">
        <field name="name">hse.benefit.loss.tree</field>
        <field name="model">hse.benefit.loss</field>
        <field name="arch" type="xml">
            <tree string="Benefits &amp; Losses" decoration-danger="event_type == 'loss'" decoration-success="event_type == 'benefit'">
                <field name="name"/>
                <field name="title"/>
                <field name="event_type" widget="badge" decoration-danger="event_type == 'loss'" decoration-success="event_type == 'benefit'"/>
                <field name="event_date"/>
                <field name="location_id"/>
                <field name="downtime_hours"/>
                <field name="total_loss" widget="monetary"/>
                <field name="total_benefit" widget="monetary"/>
                <field name="net_impact" widget="monetary"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="action_hse_benefit_loss" model="ir.actions.act_window">
        <field name="name">Benefits &amp; Losses</field>
        <field name="res_model">hse.benefit.loss</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track quantifiable production losses, environmental cleanup, fines, and safety ROI benefits.</p>
        </field>
    </record>
</odoo>
