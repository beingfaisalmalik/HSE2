<odoo>
    <data>
        <!-- Preventive Action Form View -->
        <record id="view_preventive_form" model="ir.ui.view">
            <field name="name">hse.preventive.model.form</field>
            <field name="model">hse.preventive.model</field>
            <field name="arch" type="xml">
                <form string="Preventive Action">
                    <header>
                         <button name="action_in_progress" type="object" string="In Progress" class="btn-primary"
                         invisible="status == 'in_progress'"/>
                        <button name="action_completed" type="object" string="Completed" class="btn-success"
                         invisible="status == 'completed'"/>
                        <field name="status" widget="statusbar" statusbar_visible="new,in_progress,completed,"/>
                    </header>
                    <sheet>
                        <div class="hse-x-hero" style="background: linear-gradient(135deg, #134e4a 0%, #0d9488 100%); border-left: 6px solid #5eead4; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">🛡️</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Preventive Action</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Proactive actions eliminating potential causes</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="status" widget="badge" readonly="1"/></span></div></div>
                        <widget name="web_ribbon" title="Completed" bg_color="text-bg-success"
                                invisible="status != 'completed'"/>
                        <group>
                            <group>
                            <field name="name" string="Action Title" required="1"/>
                            <field name="ra_reference_number"/>
                            <field name="action_description" string="Action Description"/>
                            <field name="due_date" string="Due Date"/>
                            </group>
                            <group>
                            <field name="responsible_user_id" string="Responsible Person"/>
                            <field name="comments" string="Comments"/>
                            <field name="completion_date" string="Completion Date"/>
                            </group>
                        </group>
                        <notebook>
                            <!-- Hazards Tab -->
                            <page string="Hazards">
                                <field name="hazard_preventive_ids">
                                    <tree editable="bottom">
                                        <field name="hazards_selection"/>
                                        <field name="description"/>
                                        <field name="risk_level"/>
                                        <field name="control_ids" widget="many2many_tags"/>
                                    </tree>
                                    <form>
                                        <div class="hse-x-hero" style="background: linear-gradient(135deg, #1e293b 0%, #334155 100%); border-left: 6px solid #94a3b8; border-radius: 10px; padding: 10px 14px; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;"><div style="display: flex; align-items: center; gap: 10px;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 8px; width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0;">📋</span><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 13px; letter-spacing: 0.3px;">Record</div></div><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span></div>
                                        <group>
                                            <field name="hazards_selection"/>
                                            <field name="description"/>
                                            <field name="risk_level"/>
                                            <field name="control_ids" widget="many2many_tags"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Preventive Action Tree View -->
        <record id="view_preventive_tree" model="ir.ui.view">
            <field name="name">hse.preventive.model.tree</field>
            <field name="model">hse.preventive.model</field>
            <field name="arch" type="xml">
                <tree string="Preventive Actions">
                    <field name="name" string="Action Title"/>
                    <field name="ra_reference_number"/>
                    <field name="status" string="Status"/>
                    <field name="due_date" string="Due Date"/>
                    <field name="responsible_user_id" string="Responsible Person"/>
                    <field name="completion_date" string="Completion Date"/>
                </tree>
            </field>
        </record>

        <record id="action_preventive_action" model="ir.actions.act_window">
            <field name="name">Preventive Action</field>
            <field name="res_model">hse.preventive.model</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
