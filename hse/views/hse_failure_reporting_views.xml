<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Failure Report Form -->
    <record id="view_hse_failure_report_form" model="ir.ui.view">
        <field name="name">hse.failure.report.form</field>
        <field name="model">hse.failure.report</field>
        <field name="arch" type="xml">
            <form string="ISO 14224 Equipment Failure Report">
                <header>
                    <button name="action_analyze" string="Perform Reliability Analysis" type="object" invisible="state != 'reported'" class="btn-primary"/>
                    <button name="action_repaired" string="Mark Repaired" type="object" invisible="state not in ('reported', 'under_analysis', 'rcfa')" class="btn-success"/>
                    <button name="action_close" string="Close Failure Record" type="object" invisible="state != 'repaired'" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="reported,under_analysis,repaired,closed"/>
                </header>
                <sheet>
                    <div class="hse-x-hero" style="background: linear-gradient(135deg, #7c2d12 0%, #ea580c 100%); border-left: 6px solid #fdba74; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">🔧</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Failure Reporting (ISO 14224)</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">FRACAS failure modes, mechanisms &amp; reliability metrics</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="state" widget="badge" readonly="1"/></span></div></div>
                    <div class="oe_title">
                        <span class="text-muted"><field name="name"/></span>
                        <h1><field name="asset_id"/> - <field name="failure_mode"/></h1>
                    </div>
                    <group>
                        <group string="Equipment Taxonomy (ISO 14224)">
                            <field name="asset_id"/>
                            <field name="equipment_class"/>
                            <field name="failed_component"/>
                            <field name="location_id"/>
                            <field name="failure_date"/>
                        </group>
                        <group string="Operational Impact &amp; Metrics">
                            <field name="impact_level"/>
                            <field name="downtime_hours"/>
                            <field name="repair_time_hours"/>
                            <field name="operating_hours"/>
                            <field name="reported_by_id"/>
                        </group>
                    </group>
                    <group string="Root Mechanism &amp; Causes">
                        <group>
                            <field name="failure_mode"/>
                            <field name="failure_mechanism"/>
                        </group>
                        <group>
                            <field name="failure_cause"/>
                            <field name="detection_method"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Remedial Action Executed">
                            <field name="remedial_action_taken" placeholder="Describe mechanical repair, parts replaced, and commissioning test results..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Failure Report Tree -->
    <record id="view_hse_failure_report_tree" model="ir.ui.view">
        <field name="name">hse.failure.report.tree</field>
        <field name="model">hse.failure.report</field>
        <field name="arch" type="xml">
            <tree string="ISO 14224 Failure Reports" decoration-danger="impact_level == 'shutdown'" decoration-warning="impact_level == 'derated'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="equipment_class"/>
                <field name="failure_mode"/>
                <field name="failure_mechanism"/>
                <field name="failure_cause"/>
                <field name="impact_level"/>
                <field name="downtime_hours"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="action_hse_failure_report" model="ir.actions.act_window">
        <field name="name">Failure Reporting (ISO 14224)</field>
        <field name="res_model">hse.failure.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Manage ISO 14224 equipment failure modes, mechanisms, causes, and MTTR.</p>
        </field>
    </record>
</odoo>
