<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Equipment Certification Form -->
    <record id="view_hse_equipment_certification_form" model="ir.ui.view">
        <field name="name">hse.equipment.certification.form</field>
        <field name="model">hse.equipment.certification</field>
        <field name="arch" type="xml">
            <form string="Equipment Statutory Certification">
                <header>
                    <button name="action_schedule_renewal" string="Schedule Renewal Inspection" type="object" invisible="state != 'expiring'" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="valid,expiring,renewal,expired"/>
                </header>
                <sheet>
                    <div class="hse-x-hero" style="background: linear-gradient(135deg, #0f172a 0%, #334155 100%); border-left: 6px solid #94a3b8; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">🏗️</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Equipment Certifications</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Statutory inspections: vessels, cranes, PSVs</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="state" widget="badge" readonly="1"/></span></div></div>
                    <div class="hse-x-meta" style="display: flex; gap: 16px; align-items: center; margin: -6px 0 10px 6px; font-size: 11px; color: #64748b; flex-wrap: wrap;"><span>🕒 Created <field name="create_date" widget="hse_relative_date" readonly="1" style="font-weight: 700; color: #475569;"/></span><span>✏️ Updated <field name="write_date" widget="hse_relative_date" readonly="1" style="font-weight: 700; color: #475569;"/></span></div>
                    <div class="oe_title">
                        <span class="text-muted"><field name="certificate_number"/></span>
                        <h1><field name="title" placeholder="Certificate Title (e.g. Annual Hydrostatic Proof Test for Separator V-101)"/></h1>
                    </div>
                    <group>
                        <group string="Equipment &amp; Inspection Authority">
                            <field name="asset_id"/>
                            <field name="location_id"/>
                            <field name="cert_type"/>
                            <field name="certifying_authority"/>
                            <field name="inspector_name"/>
                        </group>
                        <group string="Inspection Cycle &amp; Validity">
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="inspection_interval_months"/>
                            <field name="days_to_expire"/>
                        </group>
                    </group>
                    <group string="Technical Proof Test Parameters">
                        <group>
                            <field name="design_pressure_psi"/>
                            <field name="test_pressure_psi"/>
                        </group>
                        <group>
                            <field name="safe_working_load_ton"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inspection Findings &amp; Thickness Readings">
                            <field name="inspection_findings" placeholder="Record ultrasonic thickness measurements, corrosion rates, or weld examination findings..."/>
                        </page>
                        <page string="Official Certificate Document">
                            <group>
                                <field name="certificate_file" filename="file_name"/>
                                <field name="file_name" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Equipment Certification Tree -->
    <record id="view_hse_equipment_certification_tree" model="ir.ui.view">
        <field name="name">hse.equipment.certification.tree</field>
        <field name="model">hse.equipment.certification</field>
        <field name="arch" type="xml">
            <tree string="Equipment Certifications" decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'" decoration-success="state == 'valid'">
                <field name="certificate_number"/>
                <field name="title"/>
                <field name="asset_id"/>
                <field name="cert_type"/>
                <field name="certifying_authority"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_to_expire"/>
                <field name="state" widget="badge" decoration-success="state == 'valid'" decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'"/>
            </tree>
        </field>
    </record>

    <record id="action_hse_equipment_certification" model="ir.actions.act_window">
        <field name="name">Equipment Certifications</field>
        <field name="res_model">hse.equipment.certification</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Manage statutory plant inspections, pressure vessel stamps, cranes, and relief valves.</p>
        </field>
    </record>
</odoo>
