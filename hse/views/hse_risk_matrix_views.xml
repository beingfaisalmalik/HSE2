<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Risk Matrix Form View -->
    <record id="view_hse_risk_matrix_form" model="ir.ui.view">
        <field name="name">hse.risk.matrix.form</field>
        <field name="model">hse.risk.matrix</field>
        <field name="arch" type="xml">
            <form string="Risk Matrix Configuration">
                <sheet>
                    <div class="hse-x-hero" style="background: linear-gradient(135deg, #2e1065 0%, #7c3aed 100%); border-left: 6px solid #c4b5fd; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">🎯</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Dynamic Risk Matrix</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">ISO 31000 matrix definitions and cell scoring</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span></div></div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Matrix Name (e.g. Standard 5x5)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="dimension"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Consequence / Severity Levels (1-5)">
                            <field name="consequence_ids">
                                <tree editable="bottom">
                                    <field name="level"/>
                                    <field name="name"/>
                                    <field name="people_impact"/>
                                    <field name="environment_impact"/>
                                    <field name="asset_impact"/>
                                    <field name="reputation_impact"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Likelihood / Probability Levels (1-5)">
                            <field name="likelihood_ids">
                                <tree editable="bottom">
                                    <field name="level"/>
                                    <field name="name"/>
                                    <field name="frequency_description"/>
                                    <field name="probability_percentage"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Risk Matrix Tree View -->
    <record id="view_hse_risk_matrix_tree" model="ir.ui.view">
        <field name="name">hse.risk.matrix.tree</field>
        <field name="model">hse.risk.matrix</field>
        <field name="arch" type="xml">
            <tree string="Risk Matrices">
                <field name="name"/>
                <field name="dimension"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_hse_risk_matrix" model="ir.actions.act_window">
        <field name="name">Risk Matrix Configuration</field>
        <field name="res_model">hse.risk.matrix</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define enterprise Risk Matrices and Consequence / Likelihood scales.</p>
        </field>
    </record>
</odoo>
