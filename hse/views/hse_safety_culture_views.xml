<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action First -->
        <record id="action_hse_safety_culture_assessment" model="ir.actions.act_window">
            <field name="name">Safety Culture Assessments (Bradley Curve)</field>
            <field name="res_model">hse.safety.culture.assessment</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Tree View -->
        <record id="view_hse_safety_culture_assessment_tree" model="ir.ui.view">
            <field name="name">hse.safety.culture.assessment.tree</field>
            <field name="model">hse.safety.culture.assessment</field>
            <field name="arch" type="xml">
                <tree string="Safety Culture Assessments"
                      decoration-success="bradley_curve_stage in ['interdependent', 'generative']"
                      decoration-info="bradley_curve_stage == 'independent'"
                      decoration-warning="bradley_curve_stage == 'dependent'"
                      decoration-danger="bradley_curve_stage == 'reactive'">
                    <field name="name" bold="1"/>
                    <field name="assessment_date"/>
                    <field name="location_id"/>
                    <field name="lead_assessor_id"/>
                    <field name="participants_count"/>
                    <field name="overall_maturity_score" string="Maturity Score (1-5)" bold="1"/>
                    <field name="bradley_curve_stage" widget="badge"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_hse_safety_culture_assessment_form" model="ir.ui.view">
            <field name="name">hse.safety.culture.assessment.form</field>
            <field name="model">hse.safety.culture.assessment</field>
            <field name="arch" type="xml">
                <form string="Safety Culture Maturity Assessment (DuPont Bradley Curve)">
                    <header>
                        <button name="action_evaluate" string="Evaluate Maturity Score" type="object"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_approve_roadmap" string="Activate Culture Roadmap" type="object"
                                class="btn-success" invisible="state != 'evaluated'"/>
                        <button name="action_complete" string="Archive Assessment" type="object"
                                class="btn-secondary" invisible="state != 'action_plan'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,evaluated,action_plan,completed"/>
                    </header>
                    <sheet>
                        <div class="hse-x-hero" style="background: linear-gradient(135deg, #134e4a 0%, #0d9488 100%); border-left: 6px solid #5eead4; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">🧭</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Safety Culture Maturity</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Bradley Curve assessment &amp; roadmap</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="state" widget="badge" readonly="1"/></span></div></div>
                        <div class="oe_title">
                            <label for="name" string="Assessment Title"/>
                            <h1><field name="name" placeholder="e.g. 2026 Facility Safety Culture Assessment"/></h1>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="card p-3 bg-light border-0">
                                    <span class="text-muted small">Composite Maturity Rating (1.0 to 5.0)</span>
                                    <h2 class="mb-0 text-primary font-weight-bold"><field name="overall_maturity_score" readonly="1"/> / 5.0</h2>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card p-3 bg-light border-0">
                                    <span class="text-muted small">DuPont Bradley Curve Level</span>
                                    <h4 class="mb-0 text-success font-weight-bold"><field name="bradley_curve_stage" readonly="1"/></h4>
                                </div>
                            </div>
                        </div>

                        <group>
                            <group string="Assessment Scope">
                                <field name="location_id"/>
                                <field name="assessment_date"/>
                                <field name="lead_assessor_id"/>
                                <field name="participants_count"/>
                            </group>
                            <group string="5 Cultural Dimensions (Scored 1.0 - 5.0)">
                                <field name="score_leadership_commitment"/>
                                <field name="score_workforce_engagement"/>
                                <field name="score_hazard_reporting_just_culture"/>
                                <field name="score_risk_awareness_discipline"/>
                                <field name="score_continuous_learning"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Findings &amp; Roadmaps" name="findings">
                                <group>
                                    <field name="strengths"/>
                                    <field name="vulnerabilities"/>
                                    <field name="roadmap_actions"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
    </data>
</odoo>