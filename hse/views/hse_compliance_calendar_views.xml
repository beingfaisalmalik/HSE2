<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Compliance Task Tree View -->
        <record id="view_hse_compliance_task_tree" model="ir.ui.view">
            <field name="name">hse.compliance.task.tree</field>
            <field name="model">hse.compliance.task</field>
            <field name="arch" type="xml">
                <tree string="Statutory Compliance Obligations"
                      decoration-danger="is_overdue == True and state not in ['submitted', 'completed']"
                      decoration-success="state == 'completed'"
                      decoration-warning="state == 'in_progress'"
                      decoration-info="state == 'submitted'">
                    <field name="is_overdue" column_invisible="True"/>
                    <field name="task_ref"/>
                    <field name="name"/>
                    <field name="regulatory_body"/>
                    <field name="regulation_id"/>
                    <field name="task_type"/>
                    <field name="frequency"/>
                    <field name="due_date"/>
                    <field name="responsible_id" widget="many2one_avatar_user"/>
                    <field name="state" widget="badge"
                           decoration-danger="state == 'overdue' or (is_overdue == True and state not in ['submitted', 'completed'])"
                           decoration-success="state == 'completed'"
                           decoration-warning="state == 'in_progress'"
                           decoration-info="state == 'submitted'"/>
                </tree>
            </field>
        </record>

        <!-- Compliance Task Form View -->
        <record id="view_hse_compliance_task_form" model="ir.ui.view">
            <field name="name">hse.compliance.task.form</field>
            <field name="model">hse.compliance.task</field>
            <field name="arch" type="xml">
                <form string="Compliance Task &amp; Statutory Filing">
                    <header>
                        <button name="action_start" string="Start Preparation" type="object"
                                class="oe_highlight" invisible="state != 'scheduled'"/>
                        <button name="action_submit" string="Record Submission" type="object"
                                class="btn-primary" invisible="state != 'in_progress'"/>
                        <button name="action_verify" string="Verify Compliant" type="object"
                                class="btn-success" invisible="state != 'submitted'"/>
                        <button name="action_set_scheduled" string="Reset to Scheduled" type="object"
                                class="btn-secondary" invisible="state not in ['draft']"/>
                        <field name="state" widget="statusbar" statusbar_visible="scheduled,in_progress,submitted,completed"/>
                    </header>
                    <sheet>
                        <div class="hse-x-hero" style="background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%); border-left: 6px solid #93c5fd; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">🗓️</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Statutory Compliance Calendar</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Filing deadlines &amp; obligation lead-time alerts</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="state" widget="badge" readonly="1"/></span></div></div>
                        <widget name="web_ribbon" title="Compliant" bg_color="text-bg-success"
                                invisible="state != 'completed'"/>
                        <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                                invisible="is_overdue == False or state in ['submitted', 'completed']"/>
                        <field name="is_overdue" invisible="1"/>
                        <div class="oe_title">
                            <span class="o_form_label text-muted">Statutory Compliance Obligation</span>
                            <h2><field name="task_ref" readonly="1"/></h2>
                            <h1><field name="name" placeholder="e.g. Annual OSHA 300A Summary Certification &amp; Electronic Submission"/></h1>
                        </div>
                        <group>
                            <group string="Regulatory Framework">
                                <field name="regulatory_body"/>
                                <field name="regulation_id" options="{'no_quick_create': True}"/>
                                <field name="obligation_id" options="{'no_quick_create': True}"/>
                                <field name="task_type"/>
                                <field name="location_id"/>
                            </group>
                            <group string="Schedule &amp; Deadlines">
                                <field name="frequency"/>
                                <field name="due_date"/>
                                <field name="lead_time_days"/>
                                <field name="alert_date" readonly="1"/>
                                <field name="responsible_id"/>
                                <field name="approver_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Authority Submission &amp; Evidence">
                                <group>
                                    <group string="Submission Acknowledgement">
                                        <field name="submission_date"/>
                                        <field name="agency_ack_number" placeholder="e.g. EPA-TRI-2026-889104"/>
                                    </group>
                                    <group string="Documentary Evidence">
                                        <field name="evidence_filename" invisible="1"/>
                                        <field name="compliance_evidence" filename="evidence_filename"/>
                                    </group>
                                </group>
                                <separator string="Compliance Notes &amp; Legal Standard Details"/>
                                <field name="compliance_notes" placeholder="Summarize technical actions taken to satisfy statutory requirements, exemptions claimed, or agency correspondence..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Compliance Task Calendar View -->
        <record id="view_hse_compliance_task_calendar" model="ir.ui.view">
            <field name="name">hse.compliance.task.calendar</field>
            <field name="model">hse.compliance.task</field>
            <field name="arch" type="xml">
                <calendar string="Compliance Calendar" date_start="due_date" color="regulatory_body" mode="month">
                    <field name="name"/>
                    <field name="regulatory_body"/>
                    <field name="state"/>
                    <field name="responsible_id"/>
                </calendar>
            </field>
        </record>

        <!-- Compliance Task Kanban View -->
        <record id="view_hse_compliance_task_kanban" model="ir.ui.view">
            <field name="name">hse.compliance.task.kanban</field>
            <field name="model">hse.compliance.task</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" sample="1">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="task_ref"/>
                    <field name="regulatory_body"/>
                    <field name="due_date"/>
                    <field name="state"/>
                    <field name="is_overdue"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click p-3 rounded shadow-sm border #{record.is_overdue.raw_value and record.state.raw_value != 'completed' ? 'border-danger bg-danger-subtle' : 'border-light'}">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary"><t t-esc="record.task_ref.value"/></span>
                                    <span class="badge bg-primary"><t t-esc="record.regulatory_body.value"/></span>
                                </div>
                                <h5 class="fw-bold text-truncate mb-2"><t t-esc="record.name.value"/></h5>
                                <div class="text-muted small mb-2">
                                    <i class="fa fa-calendar me-1"/> Due: <span t-attf-class="#{record.is_overdue.raw_value and record.state.raw_value != 'completed' ? 'text-danger fw-bold' : ''}"><t t-esc="record.due_date.value"/></span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                    <span class="badge" t-attf-class="#{record.state.raw_value == 'completed' ? 'bg-success' : record.state.raw_value == 'submitted' ? 'bg-info' : record.state.raw_value == 'in_progress' ? 'bg-warning' : 'bg-secondary'}">
                                        <t t-esc="record.state.value"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Compliance Task Search View -->
        <record id="view_hse_compliance_task_search" model="ir.ui.view">
            <field name="name">hse.compliance.task.search</field>
            <field name="model">hse.compliance.task</field>
            <field name="arch" type="xml">
                <search string="Search Statutory Obligations">
                    <field name="name" string="Obligation / Keyword"/>
                    <field name="task_ref"/>
                    <field name="regulatory_body"/>
                    <field name="regulation_id"/>
                    <field name="responsible_id"/>
                    <separator/>
                    <filter string="Overdue Deadlines" name="filter_overdue" domain="[('is_overdue', '=', True), ('state', 'not in', ['submitted', 'completed'])]"/>
                    <filter string="Scheduled / Upcoming" name="filter_scheduled" domain="[('state', '=', 'scheduled')]"/>
                    <filter string="Preparation In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Submitted to Agency" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                    <filter string="Verified Compliant" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Regulatory Body" name="group_body" context="{'group_by': 'regulatory_body'}"/>
                        <filter string="Obligation Type" name="group_type" context="{'group_by': 'task_type'}"/>
                        <filter string="Recurrence Frequency" name="group_frequency" context="{'group_by': 'frequency'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Due Date" name="group_due_date" context="{'group_by': 'due_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action: Compliance Obligations & Statutory Calendar -->
        <record id="action_hse_compliance_task" model="ir.actions.act_window">
            <field name="name">Statutory Compliance Calendar &amp; Obligations</field>
            <field name="res_model">hse.compliance.task</field>
            <field name="view_mode">tree,calendar,kanban,form</field>
            <field name="search_view_id" ref="view_hse_compliance_task_search"/>
            <field name="context">{'search_default_filter_scheduled': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Schedule and track statutory legal compliance filings and obligations
                </p>
                <p>
                    Manage mandatory environmental filings, OSHA reports, operating permit renewals, and agency audits with automated deadline tracking.
                </p>
            </field>
        </record>

    </data>
</odoo>
