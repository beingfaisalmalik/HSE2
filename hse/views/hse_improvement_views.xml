<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Improvement Form -->
    <record id="view_hse_improvement_form" model="ir.ui.view">
        <field name="name">hse.improvement.form</field>
        <field name="model">hse.improvement</field>
        <field name="arch" type="xml">
            <form string="Continuous Improvement Opportunity">
                <header>
                    <button name="action_evaluate" string="Evaluate Business Case" type="object" invisible="state != 'submitted'" class="btn-primary"/>
                    <button name="action_approve" string="Approve Project" type="object" invisible="state != 'evaluated'" class="btn-success"/>
                    <button name="action_start" string="Start Implementation" type="object" invisible="state != 'approved'" class="btn-primary"/>
                    <button name="action_verify" string="Verify Results &amp; ROI" type="object" invisible="state != 'in_progress'" class="btn-warning"/>
                    <button name="action_close" string="Close Project" type="object" invisible="state != 'verified'" class="btn-success"/>
                    <button name="action_reject" string="Reject Idea" type="object" invisible="state in ('verified', 'closed', 'rejected')" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,evaluated,approved,in_progress,verified,closed"/>
                </header>
                <sheet>
                    <div class="hse-x-hero" style="background: linear-gradient(135deg, #134e4a 0%, #0d9488 100%); border-left: 6px solid #5eead4; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">💡</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Continuous Improvement</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Kaizen, Six Sigma and workforce suggestion engine</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="state" widget="badge" readonly="1"/></span></div></div>
                    <div class="hse-x-meta" style="display: flex; gap: 16px; align-items: center; margin: -6px 0 10px 6px; font-size: 11px; color: #64748b; flex-wrap: wrap;"><span>🕒 Created <field name="create_date" widget="hse_relative_date" readonly="1" style="font-weight: 700; color: #475569;"/></span><span>✏️ Updated <field name="write_date" widget="hse_relative_date" readonly="1" style="font-weight: 700; color: #475569;"/></span></div>
                    <div class="oe_title">
                        <span class="text-muted"><field name="name"/></span>
                        <h1><field name="title" placeholder="Improvement Opportunity Title"/></h1>
                    </div>
                    <group>
                        <group string="Program &amp; Category">
                            <field name="initiative_type"/>
                            <field name="category"/>
                            <field name="location_id"/>
                            <field name="asset_id"/>
                        </group>
                        <group string="Project Ownership &amp; Schedule">
                            <field name="project_lead_id"/>
                            <field name="sponsor_id"/>
                            <field name="target_completion_date"/>
                            <field name="actual_completion_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="current_state" placeholder="Baseline problem statement and inefficiencies observed..."/>
                        <field name="proposed_solution" placeholder="Innovative solution or engineered improvement..."/>
                    </group>
                    <notebook>
                        <page string="Benefit &amp; ROI Analysis">
                            <group>
                                <group string="Projected Financial Impact">
                                    <field name="estimated_annual_savings" widget="monetary"/>
                                    <field name="implementation_budget" widget="monetary"/>
                                    <field name="risk_reduction_points"/>
                                    <field name="manhours_saved_per_year"/>
                                </group>
                                <group string="Verified Post-Implementation Results">
                                    <field name="actual_annual_savings" widget="monetary"/>
                                    <field name="results_summary" placeholder="Document verified savings, downtime reduction, or safety improvements achieved..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Improvement Tree -->
    <record id="view_hse_improvement_tree" model="ir.ui.view">
        <field name="name">hse.improvement.tree</field>
        <field name="model">hse.improvement</field>
        <field name="arch" type="xml">
            <tree string="Continuous Improvements" decoration-success="state in ('verified', 'closed')" decoration-info="state == 'in_progress'">
                <field name="name"/>
                <field name="title"/>
                <field name="initiative_type"/>
                <field name="category"/>
                <field name="project_lead_id"/>
                <field name="estimated_annual_savings" widget="monetary"/>
                <field name="actual_annual_savings" widget="monetary"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-warning="state == 'evaluated'" decoration-primary="state == 'in_progress'" decoration-success="state in ('verified', 'closed')"/>
            </tree>
        </field>
    </record>

    <record id="action_hse_improvement" model="ir.actions.act_window">
        <field name="name">Improvements (Continuous Improvement)</field>
        <field name="res_model">hse.improvement</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Manage continuous improvement projects, Kaizen events, and cost-savings ROI.</p>
        </field>
    </record>
</odoo>
