<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- NCR Form View -->
    <record id="view_hse_ncr_form" model="ir.ui.view">
        <field name="name">hse.ncr.form</field>
        <field name="model">hse.ncr</field>
        <field name="arch" type="xml">
            <form string="Non-Conformance Report (NCR)">
                <header>
                    <button name="action_quarantine" string="Tag &amp; Quarantine" type="object" invisible="state != 'draft'" class="btn-danger"/>
                    <button name="action_request_disposition" string="Request Disposition" type="object" invisible="state != 'quarantined'" class="btn-primary"/>
                    <button name="action_approve_disposition" string="Approve Disposition" type="object" invisible="state != 'disposition_review'" class="btn-success"/>
                    <button name="action_close" string="Close NCR" type="object" invisible="state != 'disposition_approved'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel NCR" type="object" invisible="state in ('closed', 'cancelled')" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,quarantined,disposition_review,disposition_approved,closed"/>
                </header>
                <sheet>
                    <div class="hse-x-hero" style="background: linear-gradient(135deg, #7c2d12 0%, #ea580c 100%); border-left: 6px solid #fdba74; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">⚠️</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Non-Conformance (NCR)</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Quarantine, disposition and cost of non-conformance</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><div class="hse-x-kpi" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); border-radius: 10px; padding: 4px 12px; text-align: center; min-width: 86px;"><span class="hse-x-kpi-label" style="display: block; font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(203,213,225,0.9); font-weight: 700;">Total CONC ($)</span><field name="conc_total" readonly="1" style="color:#fff;font-weight:800;" widget="hse_smart_counter" /></div><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="state" widget="badge" readonly="1"/></span></div></div>
                    <div class="hse-x-meta" style="display: flex; gap: 16px; align-items: center; margin: -6px 0 10px 6px; font-size: 11px; color: #64748b; flex-wrap: wrap;"><span>🕒 Created <field name="create_date" widget="hse_relative_date" readonly="1" style="font-weight: 700; color: #475569;"/></span><span>✏️ Updated <field name="write_date" widget="hse_relative_date" readonly="1" style="font-weight: 700; color: #475569;"/></span></div>
                    <div class="oe_title">
                        <span class="text-muted"><field name="name"/></span>
                        <h1><field name="title" placeholder="NCR Title (e.g. Flange bolt metallurgy non-conformance - wrong alloy grade)"/></h1>
                    </div>
                    <group>
                        <group string="Source &amp; Identification">
                            <field name="ncr_source"/>
                            <field name="severity"/>
                            <field name="location_id"/>
                            <field name="asset_id"/>
                            <field name="supplier_id"/>
                        </group>
                        <group string="Quarantine &amp; Containment">
                            <field name="is_quarantined" widget="boolean_toggle"/>
                            <field name="quarantine_tag_no"/>
                            <field name="quarantine_location"/>
                            <field name="originator_id"/>
                            <field name="closure_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="problem_description" placeholder="Describe the physical non-conformance discovered..."/>
                        <field name="specification_requirement" placeholder="Reference the specific ASTM, ASME, or client engineering standard violated..."/>
                        <field name="immediate_containment_action" placeholder="Describe immediate isolation, tagging, or segregation actions..."/>
                    </group>
                    <notebook>
                        <page string="Technical Disposition">
                            <group>
                                <group>
                                    <field name="disposition"/>
                                    <field name="disposition_authorized_by"/>
                                </group>
                                <group>
                                    <field name="action_id"/>
                                </group>
                            </group>
                            <group>
                                <field name="disposition_justification" placeholder="Provide engineering rationale for chosen disposition..."/>
                            </group>
                        </page>
                        <page string="Cost of Non-Conformance (CONC)">
                            <group>
                                <group>
                                    <field name="conc_material_cost"/>
                                    <field name="conc_labor_cost"/>
                                </group>
                                <group>
                                    <field name="conc_delay_penalty"/>
                                    <field name="conc_total" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- NCR Tree View -->
    <record id="view_hse_ncr_tree" model="ir.ui.view">
        <field name="name">hse.ncr.tree</field>
        <field name="model">hse.ncr</field>
        <field name="arch" type="xml">
            <tree string="Non-Conformance Reports" decoration-danger="severity == 'critical'" decoration-warning="severity == 'major'">
                <field name="name"/>
                <field name="title"/>
                <field name="ncr_source"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'major'" decoration-info="severity == 'minor'"/>
                <field name="disposition"/>
                <field name="is_quarantined" widget="boolean_toggle"/>
                <field name="conc_total" widget="monetary"/>
                <field name="state" widget="badge" decoration-danger="state == 'quarantined'" decoration-warning="state == 'disposition_review'" decoration-success="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <record id="action_hse_ncr" model="ir.actions.act_window">
        <field name="name">Non-Conformance Management (NCR)</field>
        <field name="res_model">hse.ncr</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Manage non-conforming materials, quarantine tags, technical disposition, and CONC.</p>
        </field>
    </record>
</odoo>
