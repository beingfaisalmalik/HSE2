<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Defect Elimination Form -->
    <record id="view_hse_defect_elimination_form" model="ir.ui.view">
        <field name="name">hse.defect.elimination.form</field>
        <field name="model">hse.defect.elimination</field>
        <field name="arch" type="xml">
            <form string="Defect Elimination &amp; Bad Actor Project">
                <header>
                    <button name="action_start_team_review" string="Convene Cross-Functional Team" type="object" invisible="state != 'identified'" class="btn-primary"/>
                    <button name="action_execute" string="Execute Elimination Fix" type="object" invisible="state != 'team_review'" class="btn-primary"/>
                    <button name="action_start_tracking" string="Start 90-Day Defect-Free Run" type="object" invisible="state != 'action_execution'" class="btn-warning"/>
                    <button name="action_mark_eliminated" string="Confirm Defect Permanently Eliminated" type="object" invisible="state != 'tracking_period'" class="btn-success"/>
                    <button name="action_close" string="Close Project" type="object" invisible="state != 'eliminated'" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="identified,team_review,action_execution,tracking_period,eliminated,closed"/>
                </header>
                <sheet>
                    <div class="hse-x-hero" style="background: linear-gradient(135deg, #7c2d12 0%, #ea580c 100%); border-left: 6px solid #fdba74; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">🩹</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Defect Elimination Program</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Bad-actor eradication &amp; 90-day defect-free runs</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="state" widget="badge" readonly="1"/></span></div></div>
                    <div class="hse-x-meta" style="display: flex; gap: 16px; align-items: center; margin: -6px 0 10px 6px; font-size: 11px; color: #64748b; flex-wrap: wrap;"><span>🕒 Created <field name="create_date" widget="hse_relative_date" readonly="1" style="font-weight: 700; color: #475569;"/></span><span>✏️ Updated <field name="write_date" widget="hse_relative_date" readonly="1" style="font-weight: 700; color: #475569;"/></span></div>
                    <div class="oe_title">
                        <span class="text-muted"><field name="name"/></span>
                        <h1><field name="title" placeholder="Project Title (e.g. Elimination of Recurring Seal Failure on Pump P-204A)"/></h1>
                    </div>
                    <group>
                        <group string="Bad Actor Identification">
                            <field name="asset_id"/>
                            <field name="location_id"/>
                            <field name="defect_category"/>
                        </group>
                        <group string="12-Month Impact">
                            <field name="failures_last_12_months"/>
                            <field name="annual_maintenance_spend" widget="monetary"/>
                            <field name="annual_production_loss" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Cross-Functional Elimination Team">
                        <group>
                            <field name="operator_lead_id"/>
                            <field name="maintenance_lead_id"/>
                        </group>
                        <group>
                            <field name="reliability_engineer_id"/>
                            <field name="target_implementation_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="defect_description" placeholder="Chronic defect manifestations and trigger events..."/>
                        <field name="underlying_cause" placeholder="Systemic root causes identified by team..."/>
                        <field name="elimination_strategy" placeholder="Engineered modification or procedure change that prevents recurrence..."/>
                    </group>
                    <notebook>
                        <page string="Defect-Free Operation Tracking (Sustained Reliability)">
                            <group>
                                <group>
                                    <field name="elimination_completed_date"/>
                                    <field name="track_30_days" widget="boolean_toggle"/>
                                </group>
                                <group>
                                    <field name="track_60_days" widget="boolean_toggle"/>
                                    <field name="track_90_days" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Defect Elimination Tree -->
    <record id="view_hse_defect_elimination_tree" model="ir.ui.view">
        <field name="name">hse.defect.elimination.tree</field>
        <field name="model">hse.defect.elimination</field>
        <field name="arch" type="xml">
            <tree string="Defect Elimination Projects" decoration-danger="failures_last_12_months &gt;= 5" decoration-warning="state == 'tracking_period'" decoration-success="state == 'eliminated'">
                <field name="name"/>
                <field name="title"/>
                <field name="asset_id"/>
                <field name="defect_category"/>
                <field name="failures_last_12_months"/>
                <field name="annual_production_loss" widget="monetary"/>
                <field name="reliability_engineer_id"/>
                <field name="track_90_days" widget="boolean_toggle"/>
                <field name="state" widget="badge" decoration-danger="state == 'identified'" decoration-warning="state == 'tracking_period'" decoration-success="state in ('eliminated', 'closed')"/>
            </tree>
        </field>
    </record>

    <record id="action_hse_defect_elimination" model="ir.actions.act_window">
        <field name="name">Defect Elimination</field>
        <field name="res_model">hse.defect.elimination</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Eliminate recurring bad-actor defects using cross-functional teams and 90-day tracking.</p>
        </field>
    </record>
</odoo>
