<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- PSE Tree View -->
        <record id="view_hse_pse_tree" model="ir.ui.view">
            <field name="name">hse.pse.tree</field>
            <field name="model">hse.pse</field>
            <field name="arch" type="xml">
                <tree string="API RP 754 Process Safety Events" decoration-danger="tier == 'tier1'" decoration-warning="tier == 'tier2'" decoration-info="tier == 'tier3'">
                    <field name="name"/>
                    <field name="title"/>
                    <field name="location_id"/>
                    <field name="event_datetime"/>
                    <field name="tier" widget="badge" decoration-danger="tier == 'tier1'" decoration-warning="tier == 'tier2'" decoration-info="tier == 'tier3'"/>
                    <field name="chemical_name"/>
                    <field name="mass_released_kg"/>
                    <field name="threshold_exceeded" widget="boolean_toggle"/>
                    <field name="direct_cost"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- PSE Form View -->
        <record id="view_hse_pse_form" model="ir.ui.view">
            <field name="name">hse.pse.form</field>
            <field name="model">hse.pse</field>
            <field name="arch" type="xml">
                <form string="Process Safety Event (API RP 754)">
                    <header>
                        <button name="action_investigate" string="Start Investigation" type="object" invisible="state != 'reported'" class="btn-primary"/>
                        <button name="action_classify" string="Classify Event" type="object" invisible="state != 'investigating'" class="btn-secondary"/>
                        <button name="action_regulatory_report" string="Report to Regulator" type="object" invisible="state != 'classified'" class="btn-warning"/>
                        <button name="action_close" string="Close Event" type="object" invisible="state != 'regulatory_reported'" class="btn-success"/>
                        <field name="state" widget="statusbar" statusbar_visible="reported,investigating,classified,regulatory_reported,closed"/>
                    </header>
                    <sheet>
                        <div class="hse-x-hero" style="background: linear-gradient(135deg, #7f1d1d 0%, #dc2626 100%); border-left: 6px solid #fca5a5; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">📈</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Process Safety Events (API RP 754)</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Tier 1-4 LOPC event classification</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="state" widget="badge" readonly="1"/></span></div></div>
                        <div class="oe_title">
                            <span class="o_form_label">Process Safety Event Ref</span>
                            <h1><field name="name" readonly="1"/></h1>
                            <h3><field name="title" placeholder="e.g. Hexane Line Leak &amp; Flash Fire on Column Reboiler"/></h3>
                        </div>
                        <group>
                            <group string="Classification &amp; Operating Mode">
                                <field name="tier" widget="radio"/>
                                <field name="location_id"/>
                                <field name="event_datetime"/>
                                <field name="mode_of_operation"/>
                            </group>
                            <group string="Chemical Release (LOPC)">
                                <field name="chemical_id"/>
                                <field name="chemical_name"/>
                                <field name="phase_of_release"/>
                                <field name="release_duration_minutes"/>
                                <field name="mass_released_kg"/>
                                <field name="threshold_quantity_kg"/>
                                <field name="threshold_exceeded" readonly="1" widget="badge" decoration-danger="threshold_exceeded == True"/>
                            </group>
                        </group>
                        <group string="Consequence Criteria Evaluation">
                            <group>
                                <field name="has_fatality"/>
                                <field name="has_lost_time_injury"/>
                                <field name="has_hospitalization"/>
                            </group>
                            <group>
                                <field name="has_fire_explosion"/>
                                <field name="direct_cost"/>
                                <field name="offsite_impact"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Root Causes &amp; Barrier Failures" name="barriers">
                                <group>
                                    <field name="barrier_failure_summary" placeholder="Describe which SECE barriers degraded or failed during the loss of containment..."/>
                                    <field name="investigation_id"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- PSE Action Window -->
        <record id="action_hse_pse" model="ir.actions.act_window">
            <field name="name">Process Safety Events (API RP 754)</field>
            <field name="res_model">hse.pse</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
