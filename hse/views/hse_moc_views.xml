<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MOC Form View -->
    <record id="view_hse_moc_form" model="ir.ui.view">
        <field name="name">hse.moc.form</field>
        <field name="model">hse.moc</field>
        <field name="arch" type="xml">
            <form string="Management of Change">
                <header>
                    <button name="action_submit_review" string="Submit for Review" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_approve" string="Approve MOC" type="object" invisible="state != 'technical_review'" class="btn-success"/>
                    <button name="action_start_implementation" string="Start Implementation" type="object" invisible="state != 'approved'" class="btn-primary"/>
                    <button name="action_start_pssr" string="Conduct PSSR" type="object" invisible="state != 'implementation'" class="btn-warning"/>
                    <button name="action_commission" string="Commission Change" type="object" invisible="state != 'pssr'" class="btn-success"/>
                    <button name="action_close" string="Close Out MOC" type="object" invisible="state != 'commissioned'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel / Reject" type="object" invisible="state in ('closed', 'cancelled')" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,technical_review,approved,implementation,pssr,commissioned,closed"/>
                </header>
                <sheet>
                    <div class="hse-x-hero" style="background: linear-gradient(135deg, #2e1065 0%, #7c3aed 100%); border-left: 6px solid #c4b5fd; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">🔄</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Management of Change</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Permanent, temporary &amp; emergency change control with PSSR gates</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><div class="hse-x-kpi" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); border-radius: 10px; padding: 4px 12px; text-align: center; min-width: 86px;"><span class="hse-x-kpi-label" style="display: block; font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(203,213,225,0.9); font-weight: 700;">Initial Risk</span><field name="initial_risk_score" readonly="1" style="color:#fff;font-weight:800;" widget="hse_smart_counter" /></div><div class="hse-x-kpi" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); border-radius: 10px; padding: 4px 12px; text-align: center; min-width: 86px;"><span class="hse-x-kpi-label" style="display: block; font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(203,213,225,0.9); font-weight: 700;">Residual Risk</span><field name="residual_risk_score" readonly="1" style="color:#fff;font-weight:800;" widget="hse_smart_counter" /></div><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span><span class="hse-x-badge" style="background: rgba(56,189,248,0.16); border: 1px solid rgba(56,189,248,0.45); padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #bae6fd;">Status: <field name="state" widget="badge" readonly="1"/></span></div></div>
                    <div class="hse-x-meta" style="display: flex; gap: 16px; align-items: center; margin: -6px 0 10px 6px; font-size: 11px; color: #64748b; flex-wrap: wrap;"><span>🕒 Created <field name="create_date" widget="hse_relative_date" readonly="1" style="font-weight: 700; color: #475569;"/></span><span>✏️ Updated <field name="write_date" widget="hse_relative_date" readonly="1" style="font-weight: 700; color: #475569;"/></span></div>
                    <div class="oe_title">
                        <span class="text-muted"><field name="name"/></span>
                        <h1><field name="title" placeholder="Change Title (e.g. Re-route sour gas bypass line around separator V-102)"/></h1>
                    </div>
                    <group>
                        <group string="Classification &amp; Scope">
                            <field name="change_type"/>
                            <field name="category"/>
                            <field name="location_id"/>
                            <field name="asset_id"/>
                            <field name="estimated_cost"/>
                        </group>
                        <group string="Ownership &amp; Schedule">
                            <field name="initiator_id"/>
                            <field name="approver_id"/>
                            <field name="temporary_expiry_date" invisible="change_type != 'temporary'"/>
                            <field name="initial_risk_score"/>
                            <field name="residual_risk_score"/>
                        </group>
                    </group>
                    <group>
                        <field name="description_of_change" placeholder="Detailed technical description of proposed engineering or operational modification..."/>
                        <field name="justification" placeholder="Justification: safety enhancement, regulatory compliance, reliability, or debottlenecking..."/>
                    </group>
                    <notebook>
                        <page string="Discipline Technical Reviews">
                            <field name="review_ids">
                                <tree editable="bottom">
                                    <field name="discipline"/>
                                    <field name="reviewer_id"/>
                                    <field name="recommendation"/>
                                    <field name="review_comments"/>
                                    <field name="review_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Pre-Start Safety Review (PSSR)">
                            <group>
                                <group>
                                    <field name="pssr_required"/>
                                    <field name="pssr_completed" widget="boolean_toggle"/>
                                </group>
                                <group>
                                    <button name="action_load_default_pssr" string="Load Standard PSSR Checklist" type="object" class="btn btn-outline-primary btn-sm"/>
                                </group>
                            </group>
                            <field name="pssr_line_ids">
                                <tree editable="bottom">
                                    <field name="category"/>
                                    <field name="item_description"/>
                                    <field name="is_verified" widget="boolean_toggle"/>
                                    <field name="verified_by"/>
                                    <field name="verification_date"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Action Items (CAPA)">
                            <field name="action_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="assigned_to"/>
                                    <field name="target_date"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Documentation &amp; Training Impact">
                            <group>
                                <group>
                                    <field name="updates_pid"/>
                                    <field name="updates_sop"/>
                                    <field name="updates_training"/>
                                </group>
                                <group>
                                    <field name="reversion_plan" invisible="change_type != 'temporary'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- MOC Tree View -->
    <record id="view_hse_moc_tree" model="ir.ui.view">
        <field name="name">hse.moc.tree</field>
        <field name="model">hse.moc</field>
        <field name="arch" type="xml">
            <tree string="Management of Change" decoration-warning="state in ('technical_review', 'pssr')" decoration-primary="state == 'implementation'" decoration-success="state == 'commissioned'">
                <field name="name"/>
                <field name="title"/>
                <field name="change_type"/>
                <field name="category"/>
                <field name="location_id"/>
                <field name="initiator_id"/>
                <field name="pssr_completed" widget="boolean_toggle"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'technical_review'" decoration-primary="state == 'implementation'" decoration-success="state in ('commissioned', 'closed')"/>
            </tree>
        </field>
    </record>

    <record id="action_hse_moc" model="ir.actions.act_window">
        <field name="name">Management of Change (MOC)</field>
        <field name="res_model">hse.moc</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track and manage operational and engineering changes, reviews, and PSSR checklists.</p>
        </field>
    </record>
</odoo>
