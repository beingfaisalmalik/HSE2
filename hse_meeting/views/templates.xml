<odoo>
    <data>

        <record id="hse_meeting_type_view_form" model="ir.ui.view">
            <field name="name">hse_meeting_type_view_form</field>
            <field name="model">hse.meeting.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="hse_meeting_type_view_tree" model="ir.ui.view">
            <field name="name">hse_meeting_type_view_tree</field>
            <field name="model">hse.meeting.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="hse_meeting_type_action" model="ir.actions.act_window">
            <field name="name">hse.meeting.type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hse.meeting.type</field>
            <field name="view_mode">tree,form</field>
        </record>


    </data>
</odoo>
