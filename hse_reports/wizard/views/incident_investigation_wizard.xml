<odoo>
    <data>
        <record model="ir.ui.view" id="view_incident_investigation_wizard_form">
            <field name="name">Incident Investigation Wizard</field>
            <field name="model">incident.investigation.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <div class="hse-x-hero" style="background: linear-gradient(135deg, #0f172a 0%, #334155 100%); border-left: 6px solid #94a3b8; border-radius: 12px; padding: 9px 14px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.25);"><div style="display: flex; align-items: center; gap: 12px; min-width: 230px; flex: 1;"><span class="hse-x-icon" style="background: rgba(255,255,255,0.14); border-radius: 10px; width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">🖨️</span><div><div class="hse-x-hero-title" style="color: #ffffff; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">Investigation Report Wizard</div><div class="hse-x-hero-sub" style="color: rgba(226,232,240,0.85); font-size: 11.5px;">Date-range investigation summary</div></div></div><div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><span class="hse-x-chip" style="background: rgba(255,255,255,0.1); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.2); padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 600;">Ref: <field name="display_name" readonly="1" style="color:#fff;font-weight:700;"/></span></div></div>
                    <group>
                        <group>
                            <field name="start_date" />
                            <field name="end_date" />
                        </group>
                    </group>
                    <footer>
                        <button name="printhsereport" string="Print Report" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="incident_investigation_wizard_window_action" model="ir.actions.act_window">
            <field name="name">Incident Investigation Wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">incident.investigation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

<!--        <menuitem id="hse_incident_investigation_report_menu" name=" Incident Investigation Summary Report" parent="hse_wizard_report_menu"  action="incident_investigation_wizard_window_action" sequence="403"/>-->
    </data>
</odoo>