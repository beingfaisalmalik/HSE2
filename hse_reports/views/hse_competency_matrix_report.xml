<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Training & Competency Gap Matrix Report (dynamic) -->
        <template id="report_hse_competency_matrix_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page" style="font-family: Arial, sans-serif; font-size: 10.5px; line-height: 1.35; color: #1e293b;">
                            <div style="background: linear-gradient(135deg, #2e1065 0%, #7c3aed 100%); color: #ffffff; padding: 14px 18px; border-radius: 8px; margin-bottom: 14px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
                                    <div>
                                        <h3 style="margin: 0; font-size: 18px; font-weight: bold; color: #ffffff;">TRAINING &amp; COMPETENCY GAP MATRIX</h3>
                                        <div style="font-size: 10px; color: #ddd6fe;">Assessed <t t-esc="doc.evaluation_date"/> by <t t-esc="doc.evaluated_by.name"/></div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-size: 11px; color: #ede9fe;"><t t-esc="doc.department_id.name or 'All Departments'"/></div>
                                        <div style="font-size: 10px; color: #c4b5fd;">
                                            <t t-foreach="doc.job_ids" t-as="j" t-esc="j.name"/> 
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <table class="table table-sm" style="width: 100%; margin-bottom: 12px; border-collapse: collapse;">
                                <tr>
                                    <td style="text-align:center; background:#f5f3ff; border:1px solid #ddd6fe; border-radius:6px; padding:8px;"><div style="font-size:17px; font-weight:800; color:#5b21b6;"><t t-esc="doc.total_evaluated"/></div><div style="font-size:8.5px; text-transform:uppercase; color:#6d28d9;">Evaluated</div></td>
                                    <td style="text-align:center; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:6px; padding:8px;"><div style="font-size:17px; font-weight:800; color:#15803d;"><t t-esc="doc.compliant_count"/></div><div style="font-size:8.5px; text-transform:uppercase; color:#166534;">Compliant</div></td>
                                    <td style="text-align:center; background:#fffbeb; border:1px solid #fde68a; border-radius:6px; padding:8px;"><div style="font-size:17px; font-weight:800; color:#b45309;"><t t-esc="doc.expiring_count"/></div><div style="font-size:8.5px; text-transform:uppercase; color:#92400e;">Expiring</div></td>
                                    <td style="text-align:center; background:#fef2f2; border:1px solid #fecaca; border-radius:6px; padding:8px;"><div style="font-size:17px; font-weight:800; color:#b91c1c;"><t t-esc="doc.gap_count"/></div><div style="font-size:8.5px; text-transform:uppercase; color:#991b1b;">Gaps</div></td>
                                    <td style="text-align:center; background:#eef2ff; border:1px solid #c7d2fe; border-radius:6px; padding:8px;"><div style="font-size:17px; font-weight:800; color:#4338ca;"><t t-esc="doc.compliance_rate"/>%</div><div style="font-size:8.5px; text-transform:uppercase; color:#3730a3;">Score</div></td>
                                </tr>
                            </table>

                            <table class="table table-bordered table-sm" style="width: 100%;">
                                <tr style="background: #f5f3ff; font-weight: bold;">
                                    <td>Employee</td>
                                    <td>Job Role</td>
                                    <td>Competency</td>
                                    <td style="width:10%;">Required</td>
                                    <td style="width:10%;">Current</td>
                                    <td style="width:11%;">Expiry</td>
                                    <td style="width:13%;">Status</td>
                                </tr>
                                <tr t-foreach="doc.line_ids" t-as="l">
                                    <td><t t-esc="l.employee_id.name"/></td>
                                    <td><t t-esc="l.job_id.name or '—'"/></td>
                                    <td><t t-esc="l.competency_id.name"/></td>
                                    <td style="text-align:center;"><t t-esc="dict(l._fields['required_level'].selection).get(l.required_level, l.required_level or '—')"/></td>
                                    <td style="text-align:center;"><t t-esc="dict(l._fields['current_level'].selection).get(l.current_level, l.current_level or '—')"/></td>
                                    <td style="text-align:center;"><t t-esc="l.expiry_date or '—'"/></td>
                                    <td>
                                        <span t-att-style="'display:inline-block; padding:1px 8px; border-radius:999px; font-size:9px; font-weight:bold; ' + ('background:#fef2f2; color:#b91c1c;' if l.status in ['expired','missing'] else 'background:#fffbeb; color:#b45309;' if l.status == 'expiring_soon' else 'background:#f0fdf4; color:#15803d;')">
                                            <t t-esc="dict(l._fields['status'].selection).get(l.status, l.status or '')"/>
                                        </span>
                                    </td>
                                </tr>
                                <tr t-if="not doc.line_ids">
                                    <td colspan="7" style="text-align:center; color:#94a3b8;">Run 'Evaluate Matrix' to compute competency gap lines.</td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="action_report_hse_competency_matrix" model="ir.actions.report">
            <field name="name">Competency Gap Matrix</field>
            <field name="model">hse.training.matrix</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hse_reports.report_hse_competency_matrix_template</field>
            <field name="report_file">hse_reports.report_hse_competency_matrix_template</field>
            <field name="binding_model_id" ref="hse.model_hse_training_matrix"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
