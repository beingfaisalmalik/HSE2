<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Plant Equipment Statutory Certification Report (dynamic) -->
        <template id="report_hse_equipment_cert_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; line-height: 1.4; color: #1e293b;">
                            <div style="background: linear-gradient(135deg, #7c2d12 0%, #ea580c 100%); color: #ffffff; padding: 14px 18px; border-radius: 8px; margin-bottom: 16px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
                                    <div>
                                        <h3 style="margin: 0; font-size: 18px; font-weight: bold; color: #ffffff;">STATUTORY CERTIFICATION REPORT</h3>
                                        <div style="font-size: 10px; color: #fed7aa;"><t t-esc="dict(doc._fields['cert_type'].selection).get(doc.cert_type, doc.cert_type or '')"/></div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-size: 14px; font-weight: bold; color: #ffffff;"><t t-esc="doc.name"/> · <t t-esc="doc.certificate_number"/></div>
                                        <div style="font-size: 10px;">
                                            <span t-att-style="'padding:2px 10px; border-radius:999px; font-weight:bold; ' + ('background:#fef2f2; color:#b91c1c;' if doc.is_expired else 'background:#fffbeb; color:#b45309;' if doc.is_expiring_soon else 'background:#f0fdf4; color:#15803d;')">
                                                <t t-if="doc.is_expired">EXPIRED</t>
                                                <t t-elif="doc.is_expiring_soon">EXPIRING IN <t t-esc="doc.days_to_expire"/>d</t>
                                                <t t-else="">VALID · <t t-esc="doc.days_to_expire"/>d remaining</t>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <table class="table table-bordered table-sm" style="width: 100%; margin-bottom: 12px;">
                                <tr style="background: #fff7ed;">
                                    <th colspan="4" style="font-size: 12px;">Certification &amp; Equipment</th>
                                </tr>
                                <tr>
                                    <td style="width: 22%; font-weight: bold; background: #f8fafc;">Description:</td>
                                    <td colspan="3"><strong><t t-esc="doc.title"/></strong></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; background: #f8fafc;">Equipment / Asset:</td>
                                    <td><t t-esc="doc.asset_id.name"/></td>
                                    <td style="font-weight: bold; background: #f8fafc;">Plant Area:</td>
                                    <td><t t-esc="doc.location_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; background: #f8fafc;">Certifying Authority:</td>
                                    <td><t t-esc="doc.certifying_authority"/></td>
                                    <td style="font-weight: bold; background: #f8fafc;">Inspector:</td>
                                    <td><t t-esc="doc.inspector_name or '—'"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; background: #f8fafc;">Issue Date:</td>
                                    <td><t t-esc="doc.issue_date"/></td>
                                    <td style="font-weight: bold; background: #f8fafc;">Expiry Date:</td>
                                    <td><strong><t t-esc="doc.expiry_date"/></strong></td>
                                </tr>
                            </table>

                            <table class="table table-bordered table-sm" style="width: 100%; margin-bottom: 12px;">
                                <tr style="background: #fff7ed;">
                                    <th colspan="3" style="font-size: 12px;">Technical Test Parameters</th>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; background: #f8fafc; width: 33%;">Design Pressure:</td>
                                    <td style="width: 33%;"><t t-esc="doc.design_pressure_psi"/> PSI/Bar</td>
                                    <td>Hydrostatic Test Pressure: <strong><t t-esc="doc.test_pressure_psi"/> PSI/Bar</strong></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; background: #f8fafc;">Safe Working Load:</td>
                                    <td colspan="2"><t t-esc="doc.safe_working_load_ton"/> metric tons</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; background: #f8fafc;">Findings:</td>
                                    <td colspan="2"><t t-esc="doc.inspection_findings or '—'"/></td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="action_report_hse_equipment_cert" model="ir.actions.report">
            <field name="name">Statutory Certification Report</field>
            <field name="model">hse.equipment.certification</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hse_reports.report_hse_equipment_cert_template</field>
            <field name="report_file">hse_reports.report_hse_equipment_cert_template</field>
            <field name="binding_model_id" ref="hse.model_hse_equipment_certification"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
