<odoo>
    <data>
        <template id="hse_capa_report">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <h1>Summary Report Of CAPA</h1>
                    <t t-if="data">
                        <div class="page" style="padding: 40px; font-family: 'Arial', sans-serif; line-height: 1.6;">

                            <table class="table table-bordered">
                                <thead><tr><th>Action title</th><th>Reference</th><th>Action type</th><th>Status</th><th>Due date</th><th>Assigned user</th><th>Completion date</th></tr></thead>
                                <tbody>
                                     <t t-foreach="data.items()" t-as="t">
                                        <tr>
                                            <td>
                                                <t t-esc="t[1]['name']"/>
                                            </td>
                                            <td>
                                                <t t-esc="t[1]['ra_reference_number']"/>
                                            </td>
                                            <td>
                                                <t t-esc="t[1]['select_capa']"/>
                                            </td>
                                            <td>
                                                <t t-esc="t[1]['status']"/>
                                            </td>
                                            <td>
                                                <t t-esc="t[1]['due_date']"/>
                                            </td>
                                            <td>
                                                <t t-esc="t[1]['responsible_user_id.name']"/>
                                            </td>
                                            <td>
                                                <t t-esc="t[1]['completion_date']"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                        </div>
                    </t>
                    <t t-else="">
                        <div class="page"
                             style="padding: 40px; font-family: 'Arial', sans-serif; line-height: 1.6; text-align: center;">
                            <p>No data found for the selected date range.</p>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
