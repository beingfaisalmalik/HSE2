<odoo>
    <data>
        <template id="hse_incident_investigation_report">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <h1>Summary Report Of Incident Investigation</h1>
                    <t t-if="data">
                        <div class="page" style="padding: 40px; font-family: 'Arial', sans-serif; line-height: 1.6;">

                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <td>
                                            Name:
                                        </td>
                                        <td>
                                            Incident ID:
                                        </td>
                                        <td>
                                            Investigation Leader:
                                        </td>
                                        <td>
                                            Target Date:
                                        </td>
                                        <td>
                                            Actual Completion Date:
                                        </td>
                                        <td>
                                            Status:
                                        </td>
                                    </tr>
                                </thead>
                                <tbody>
                                     <t t-foreach="data.items()" t-as="t">
                                        <tr>
                                            <td>
                                                <t t-esc="t[1]['ref_name']"/>
                                            </td>
                                            <td>
                                                <t t-esc="t[1]['incident_id.name']"/>
                                            </td>

                                            <td>
                                                <t t-esc="t[1]['investigation_leader.name']"/>
                                            </td>
                                            <td>
                                                <t t-esc="t[1]['target_date']"/>
                                            </td>
                                            <td>
                                                <t t-esc="t[1]['actual_completion_date']"/>
                                            </td>
                                            <td>
                                                <t t-esc="t[1]['state']"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                        </div>
                    </t>
                    <t t-else="">
                        <div class="page"
                             style="padding: 40px; font-family: 'Arial', sans-serif; line-height: 1.6; text-align: center;">
                            <p>No data found for the selected date range.</p>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
