<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Incident Log ===================== -->
    <record id="view_hse_incident_log_tree" model="ir.ui.view">
        <field name="name">hse.incident.log.tree</field>
        <field name="model">hse.incident.log</field>
        <field name="arch" type="xml">
            <tree string="Incident Log (Non-Injury)"
                  decoration-muted="status == 'closed'">
                <field name="name"/>
                <field name="date"/>
                <field name="incident_type"/>
                <field name="department"/>
                <field name="area_asset"/>
                <field name="estimated_impact"/>
                <field name="corrective_action_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'closed'"
                       decoration-warning="status == 'open'"/>
            </tree>
        </field>
    </record>

    <record id="view_hse_incident_log_form" model="ir.ui.view">
        <field name="name">hse.incident.log.form</field>
        <field name="model">hse.incident.log</field>
        <field name="arch" type="xml">
            <form string="Incident">
                <header>
                    <button name="action_mark_closed" type="object"
                            string="Mark Closed" class="btn-primary"
                            invisible="status == 'closed'"/>
                    <button name="action_mark_open" type="object"
                            string="Reopen" invisible="status == 'open'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="incident_type"/>
                            <field name="department"/>
                        </group>
                        <group>
                            <field name="area_asset"/>
                            <field name="estimated_impact"/>
                            <field name="corrective_action_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="What happened?"/>
                        </page>
                        <page string="Root Cause">
                            <field name="root_cause"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hse_incident_log_search" model="ir.ui.view">
        <field name="name">hse.incident.log.search</field>
        <field name="model">hse.incident.log</field>
        <field name="arch" type="xml">
            <search string="Incidents">
                <field name="name"/>
                <field name="department"/>
                <filter name="filter_open" string="Open" domain="[('status','=','open')]"/>
                <filter name="filter_date" string="Date" date="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'incident_type'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hse_incident_log" model="ir.actions.act_window">
        <field name="name">Incident Log (Non-Injury)</field>
        <field name="res_model">hse.incident.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_hse_incident_log" name="Incident Log"
              parent="hse_safety_dashboard.menu_hse_registers"
              action="action_hse_incident_log" sequence="40"/>
</odoo>
