<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Import wizard ===================== -->
    <record id="view_hse_excel_import_form" model="ir.ui.view">
        <field name="name">hse.excel.import.form</field>
        <field name="model">hse.excel.import</field>
        <field name="arch" type="xml">
            <form string="Import Safety Dashboard Workbook">
                <field name="state" invisible="1"/>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Upload the client's <b>Safety Dashboard (.xlsx)</b>
                        workbook. The wizard imports the Injury Log, Near-Miss
                        Log, Unsafe Act/Condition Log, Incident Log,
                        Corrective Actions, PTW register (both column
                        layouts), man-hours and Leading Indicators.
                        Existing IDs are skipped, so re-import is safe.
                        Dates that cannot be read are left empty and will be
                        flagged by the data-health checks — nothing is invented.
                    </div>
                    <group invisible="state == 'done'">
                        <field name="filename" invisible="1"/>
                        <field name="file" filename="filename"/>
                    </group>
                    <group invisible="state != 'done'">
                        <field name="log" nolabel="1" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"
                            invisible="state == 'done'"
                            data-hotkey="q"/>
                    <button string="Close" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hse_excel_import" model="ir.actions.act_window">
        <field name="name">Import Excel Workbook</field>
        <field name="res_model">hse.excel.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ===================== Report wizard ===================== -->
    <record id="view_hse_report_wizard_form" model="ir.ui.view">
        <field name="name">hse.report.wizard.form</field>
        <field name="model">hse.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Safety Reports">
                <div class="alert alert-info" role="alert">
                    The <b>year</b> list is built from the registers
                    themselves (data-driven); the <b>month</b>,
                    <b>department</b> and <b>status</b> filters apply to the
                    workflow/register reports and the Excel workbook.
                </div>
                <group>
                    <field name="report_type"/>
                    <field name="year"/>
                    <field name="month"/>
                    <field name="department"/>
                    <field name="status_filter"/>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hse_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Reports</field>
        <field name="res_model">hse.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Per-workflow shortcuts: each opens the wizard pre-set to that
         report so every workflow report is directly visible in the menu. -->
    <record id="action_hse_report_kpi" model="ir.actions.act_window">
        <field name="name">KPI Calculations Report</field>
        <field name="res_model">hse.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'kpi_pdf'}</field>
    </record>
    <record id="action_hse_report_leading" model="ir.actions.act_window">
        <field name="name">Leading Indicators Report</field>
        <field name="res_model">hse.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'leading_pdf'}</field>
    </record>
    <record id="action_hse_report_injury" model="ir.actions.act_window">
        <field name="name">Injury Log Report</field>
        <field name="res_model">hse.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'injury_pdf'}</field>
    </record>
    <record id="action_hse_report_near_miss" model="ir.actions.act_window">
        <field name="name">Near-Miss Log Report</field>
        <field name="res_model">hse.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'near_miss_pdf'}</field>
    </record>
    <record id="action_hse_report_uac" model="ir.actions.act_window">
        <field name="name">Unsafe Act / Condition Report</field>
        <field name="res_model">hse.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'uac_pdf'}</field>
    </record>
    <record id="action_hse_report_incident" model="ir.actions.act_window">
        <field name="name">Incident Log Report</field>
        <field name="res_model">hse.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'incident_pdf'}</field>
    </record>
    <record id="action_hse_report_ca" model="ir.actions.act_window">
        <field name="name">Corrective Actions Report</field>
        <field name="res_model">hse.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'ca_pdf'}</field>
    </record>
    <record id="action_hse_report_ptw" model="ir.actions.act_window">
        <field name="name">PTW Register Report</field>
        <field name="res_model">hse.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'ptw_pdf'}</field>
    </record>
    <record id="action_hse_report_figures" model="ir.actions.act_window">
        <field name="name">Monthly Figures Report</field>
        <field name="res_model">hse.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'figures_pdf'}</field>
    </record>

    <!-- ===================== Reporting menus (after the actions) ======== -->
    <menuitem id="menu_hse_import_excel"
              name="Import Excel Workbook"
              parent="menu_hse_reporting"
              action="action_hse_excel_import"
              sequence="10"
              groups="hse_safety_dashboard.group_hse_safety_manager"/>

    <menuitem id="menu_hse_report_wizard"
              name="Generate Reports"
              parent="menu_hse_reporting"
              action="action_hse_report_wizard"
              sequence="20"/>

    <menuitem id="menu_hse_report_kpi"
              name="KPI Calculations"
              parent="menu_hse_reporting"
              action="action_hse_report_kpi"
              sequence="30"/>

    <menuitem id="menu_hse_report_leading"
              name="Leading Indicators"
              parent="menu_hse_reporting"
              action="action_hse_report_leading"
              sequence="35"/>

    <!-- One menu entry per workflow — every workflow report is visible -->
    <menuitem id="menu_hse_workflow_reports"
              name="Workflow Reports"
              parent="menu_hse_reporting"
              sequence="40"/>

    <menuitem id="menu_hse_report_injury"
              name="Injury Log"
              parent="menu_hse_workflow_reports"
              action="action_hse_report_injury"
              sequence="10"/>
    <menuitem id="menu_hse_report_near_miss"
              name="Near-Miss Log"
              parent="menu_hse_workflow_reports"
              action="action_hse_report_near_miss"
              sequence="20"/>
    <menuitem id="menu_hse_report_uac"
              name="Unsafe Act / Condition"
              parent="menu_hse_workflow_reports"
              action="action_hse_report_uac"
              sequence="30"/>
    <menuitem id="menu_hse_report_incident"
              name="Incident Log"
              parent="menu_hse_workflow_reports"
              action="action_hse_report_incident"
              sequence="40"/>
    <menuitem id="menu_hse_report_ca"
              name="Corrective Actions"
              parent="menu_hse_workflow_reports"
              action="action_hse_report_ca"
              sequence="50"/>
    <menuitem id="menu_hse_report_ptw"
              name="PTW Register"
              parent="menu_hse_workflow_reports"
              action="action_hse_report_ptw"
              sequence="60"/>
    <menuitem id="menu_hse_report_figures"
              name="Monthly Figures"
              parent="menu_hse_workflow_reports"
              action="action_hse_report_figures"
              sequence="70"/>
</odoo>
