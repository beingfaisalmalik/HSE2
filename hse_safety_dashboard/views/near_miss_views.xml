<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Near Miss Log ===================== -->
    <record id="view_hse_near_miss_log_tree" model="ir.ui.view">
        <field name="name">hse.near.miss.log.tree</field>
        <field name="model">hse.near.miss.log</field>
        <field name="arch" type="xml">
            <tree string="Near-Miss Log"
                  decoration-danger="potential_severity == 'high'"
                  decoration-muted="status == 'closed'">
                <field name="name"/>
                <field name="date"/>
                <field name="department"/>
                <field name="potential_severity" widget="badge"
                       decoration-danger="potential_severity == 'high'"
                       decoration-warning="potential_severity == 'medium'"
                       decoration-success="potential_severity == 'low'"/>
                <field name="reported_by"/>
                <field name="corrective_action_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'closed'"
                       decoration-warning="status == 'open'"/>
            </tree>
        </field>
    </record>

    <record id="view_hse_near_miss_log_form" model="ir.ui.view">
        <field name="name">hse.near.miss.log.form</field>
        <field name="model">hse.near.miss.log</field>
        <field name="arch" type="xml">
            <form string="Near Miss">
                <header>
                    <button name="action_mark_closed" type="object"
                            string="Mark Closed" class="btn-primary"
                            invisible="status == 'closed'"/>
                    <button name="action_mark_open" type="object"
                            string="Reopen" invisible="status == 'open'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="department"/>
                            <field name="potential_severity"/>
                        </group>
                        <group>
                            <field name="reported_by"/>
                            <field name="corrective_action_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="What was observed?"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hse_near_miss_log_search" model="ir.ui.view">
        <field name="name">hse.near.miss.log.search</field>
        <field name="model">hse.near.miss.log</field>
        <field name="arch" type="xml">
            <search string="Near Misses">
                <field name="name"/>
                <field name="department"/>
                <filter name="filter_open" string="Open" domain="[('status','=','open')]"/>
                <filter name="filter_high" string="High severity"
                        domain="[('potential_severity','=','high')]"/>
                <filter name="filter_date" string="Date" date="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_sev" string="Severity" context="{'group_by': 'potential_severity'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hse_near_miss_log" model="ir.actions.act_window">
        <field name="name">Near-Miss Log</field>
        <field name="res_model">hse.near.miss.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_hse_near_miss_log" name="Near-Miss Log"
              parent="hse_safety_dashboard.menu_hse_registers"
              action="action_hse_near_miss_log" sequence="20"/>
</odoo>
