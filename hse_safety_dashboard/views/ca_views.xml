<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Corrective Actions ===================== -->
    <record id="view_hse_corrective_action_tree" model="ir.ui.view">
        <field name="name">hse.corrective.action.tree</field>
        <field name="model">hse.corrective.action</field>
        <field name="arch" type="xml">
            <tree string="Corrective Actions"
                  decoration-danger="overdue == True"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="related_ref"/>
                <field name="related_display"/>
                <field name="action_description"/>
                <field name="responsible_person"/>
                <field name="target_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'closed'"
                       decoration-warning="state in ('open','in_progress')"/>
                <field name="overdue" widget="boolean_toggle"/>
                <field name="closure_date"/>
            </tree>
        </field>
    </record>

    <record id="view_hse_corrective_action_form" model="ir.ui.view">
        <field name="name">hse.corrective.action.form</field>
        <field name="model">hse.corrective.action</field>
        <field name="arch" type="xml">
            <form string="Corrective Action">
                <header>
                    <button name="action_start" type="object"
                            string="Start Progress" class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_close" type="object"
                            string="Close" class="btn-primary"
                            invisible="state == 'closed'"/>
                    <button name="action_reopen" type="object"
                            string="Reopen" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="related_ref"/>
                            <field name="related_display"/>
                            <field name="related_date"/>
                            <field name="responsible_person"/>
                        </group>
                        <group>
                            <field name="target_date"/>
                            <field name="closure_date"/>
                            <field name="overdue" widget="badge"
                                   decoration-danger="overdue == True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Action">
                            <field name="action_description"
                                   placeholder="What must be done?"/>
                        </page>
                        <page string="Verification">
                            <field name="verification"
                                   placeholder="How was completion verified?"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hse_corrective_action_search" model="ir.ui.view">
        <field name="name">hse.corrective.action.search</field>
        <field name="model">hse.corrective.action</field>
        <field name="arch" type="xml">
            <search string="Corrective Actions">
                <field name="name"/>
                <field name="related_ref"/>
                <field name="responsible_person"/>
                <filter name="filter_open" string="Open"
                        domain="[('state','!=','closed')]"/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('state','!=','closed'),('target_date','!=',False),('target_date','&lt;', today)]"/>
                <filter name="filter_no_target" string="No target date"
                        domain="[('state','!=','closed'),('target_date','=',False)]"/>
                <filter name="filter_date" string="Target Date" date="target_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_resp" string="Responsible" context="{'group_by': 'responsible_person'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hse_corrective_action" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">hse.corrective.action</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>

    <menuitem id="menu_hse_corrective_action" name="Corrective Actions"
              parent="hse_safety_dashboard.menu_hse_registers"
              action="action_hse_corrective_action" sequence="50"/>
</odoo>
